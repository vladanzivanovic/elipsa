{
    "name": "vladapoz/elipsa",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "beberlei/doctrineextensions": "*",
        "doctrine/doctrine-bundle": "^2.9",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.14",
        "drewm/mailchimp-api": "*",
        "egulias/email-validator": "*",
        "friendsofsymfony/jsrouting-bundle": "*",
        "gedmo/doctrine-extensions": "*",
        "liip/imagine-bundle": "*",
        "nelmio/security-bundle": "*",
        "presta/sitemap-bundle": "*",
        "ramsey/uuid-doctrine": "*",
        "sensio/framework-extra-bundle": "*",
        "sentry/sentry-symfony": "*",
        "shuchkin/simplexlsx": "*",
        "symfony/dotenv": "5.4.*",
        "symfony/flex": "^1.3.1",
        "symfony/mailer": "5.4.*",
        "symfony/monolog-bundle": "*",
        "symfony/notifier": "5.4.*",
        "symfony/security-bundle": "5.4.*",
        "symfony/twig-bundle": "5.4.*",
        "symfony/validator": "5.4.*",
        "symfony/web-link": "5.4.*",
        "symfony/webpack-encore-bundle": "^1.16",
        "tattali/mobile-detect-bundle": "*",
        "twig/extra-bundle": "*",
        "webmozart/assert": "^1.11",
        "willdurand/js-translation-bundle": "*"
    },
    "require-dev": {
        "symfony/debug-bundle": "5.4.*",
        "symfony/maker-bundle": "*",
        "symfony/web-profiler-bundle": "5.4.*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "develop": [
            "composer dump-autoload --classmap-authoritative --ansi",
            "composer install",
            "composer dump-autoload --classmap-authoritative --ansi",
            "php bin/console doctrine:cache:clear-metadata",
            "php bin/console doctrine:schema:update --force",
            "php bin/console doctrine:migration:migrate --no-interaction",
            "php bin/console assets:install --symlink public/js",
            "php bin/console fos:js-routing:dump --format=json --target=public/js/fos_js_routes.json",
            "php bin/console bazinga:js-translation:dump public/js --format json --merge-domains",
            "npm install",
            "npm run dev"
        ],
        "production": [
            "composer install --no-dev --optimize-autoloader",
            "composer dump-autoload --optimize --no-dev --classmap-authoritative",
            "composer dump-env prod",
            "php bin/console doctrine:schema:update --force -e prod",
            "php bin/console doctrine:migration:migrate --no-interaction -e prod",
            "php bin/console cache:clear --no-warmup -e prod --ansi",
            "php bin/console cache:warmup -e prod",
            "php bin/console assets:install --symlink public/js",
            "npm install",
            "npm run build",
            "php bin/console presta:sitemaps:dump --gzip"
        ],
        "zip-prod": [
            "Composer\\Config::disableProcessTimeout",
            "rm -f public/sitemap.*",
            "rm prod.zip",
            "zip -r prod.zip ./vendor ./config/ ./src ./public ./templates ./translations ./node_modules ./package.json ./composer.json ./composer.lock ./symfony.lock ./bin ./.env.dist"
        ],
        "cache:clear": [
            "php bin/console cache:clear --no-warmup --ansi",
            "php bin/console cache:warmup"
        ],
        "cache:clear:prod": [
            "php bin/console cache:clear --no-warmup -e prod --ansi",
            "php bin/console cache:warmup -e prod"
        ],
        "route-locale-generate": [
            "php bin/console fos:js-routing:dump --format=json --target=public/js/fos_js_routes.json",
            "php bin/console bazinga:js-translation:dump public/js --format json --merge-domains"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "5.4.*"
        }
    }
}
