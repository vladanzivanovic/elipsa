{
    "name": "vladapoz/elipsa",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "beberlei/doctrineextensions": "^1.2",
        "drewm/mailchimp-api": "^2.5",
        "friendsofsymfony/jsrouting-bundle": "^2.5",
        "gedmo/doctrine-extensions": "^2.4",
        "guzzlehttp/psr7": "^1.6",
        "liip/imagine-bundle": "^2.1",
        "mobiledetect/mobiledetectlib": "^2.8",
        "nelmio/security-bundle": "^2.10",
        "php-http/guzzle6-adapter": "^2.0",
        "presta/sitemap-bundle": "^2.0",
        "ramsey/uuid-doctrine": "^1.6",
        "sensio/framework-extra-bundle": "^5.6",
        "sentry/sentry-symfony": "^3.5",
        "shuchkin/simplexlsx": "^0.8.15",
        "symfony/asset": "5.1.*",
        "symfony/cache": "5.1.*",
        "symfony/console": "5.1.*",
        "symfony/dotenv": "5.1.*",
        "symfony/expression-language": "5.1.*",
        "symfony/flex": "^1.3.1",
        "symfony/form": "5.1.*",
        "symfony/framework-bundle": "5.1.*",
        "symfony/google-mailer": "5.1.*",
        "symfony/http-client": "5.1.*",
        "symfony/intl": "5.1.*",
        "symfony/mailer": "5.1.*",
        "symfony/monolog-bundle": "^3.1",
        "symfony/notifier": "5.1.*",
        "symfony/orm-pack": "*",
        "symfony/process": "5.1.*",
        "symfony/security-bundle": "5.1.*",
        "symfony/serializer-pack": "*",
        "symfony/string": "5.1.*",
        "symfony/translation": "5.1.*",
        "symfony/twig-pack": "*",
        "symfony/validator": "5.1.*",
        "symfony/web-link": "5.1.*",
        "symfony/webpack-encore-bundle": "^1.7",
        "symfony/yaml": "5.1.*",
        "willdurand/js-translation-bundle": "^3.0"
    },
    "require-dev": {
        "symfony/debug-pack": "*",
        "symfony/maker-bundle": "^1.0",
        "symfony/profiler-pack": "*",
        "symfony/test-pack": "*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "develop": [
            "composer dump-autoload --classmap-authoritative --ansi",
            "composer install",
            "composer dump-autoload --classmap-authoritative --ansi",
            "php bin/console doctrine:cache:clear-metadata",
            "php bin/console doctrine:schema:update --force",
            "php bin/console doctrine:migration:migrate --no-interaction",
            "php bin/console assets:install --symlink public/js",
            "php bin/console fos:js-routing:dump --format=json --target=public/js/fos_js_routes.json",
            "php bin/console bazinga:js-translation:dump public/js --format json --merge-domains",
            "npm install",
            "npm run dev"
        ],
        "deploy": [
            "composer install",
            "composer dump-autoload --no-dev --classmap-authoritative",
            "php bin/console doctrine:schema:update --force -e prod",
            "php bin/console doctrine:migration:migrate --no-interaction -e prod",
            "php bin/console cache:clear --no-warmup -e prod --ansi",
            "php bin/console cache:warmup -e prod",
            "php bin/console assets:install --symlink public/js",
            "npm install",
            "npm run build",
            "php bin/console presta:sitemaps:dump --gzip"
        ],
        "cache:clear": [
            "php bin/console cache:clear --no-warmup --ansi",
            "php bin/console cache:warmup"
        ],
        "cache:clear:prod": [
            "php bin/console cache:clear --no-warmup -e prod --ansi",
            "php bin/console cache:warmup -e prod"
        ],
        "route-locale-generate": [
            "php bin/console fos:js-routing:dump --format=json --target=public/js/fos_js_routes.json",
            "php bin/console bazinga:js-translation:dump public/js --format json --merge-domains"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "5.1.*"
        }
    }
}
