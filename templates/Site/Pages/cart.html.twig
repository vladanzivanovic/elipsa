{% extends 'Site/base.html.twig' %}

{% block title %}{{ 'title.your_cart' | trans }}{% endblock %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': 'cart.name' | trans }], 'activePage': 'cart.name' | trans}) }}

    {{ include('Site/Components/cartHeader.html.twig') }}
    <!-- shopping-cart-table-area-start -->
    <div class="shopping-cart-table-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="shopping-cart-table table-responsive">
                        <table>
                            <thead>
                            <tr>
                                <th class="cart-img-title letter-capitalize">{{ 'cart.table.image' | trans }}</th>
                                <th class="cart-pro-name letter-capitalize">{{ 'cart.table.product_name' | trans }}</th>
                                <th class="cart-pro-price letter-capitalize">{{ 'cart.table.price' | trans }}</th>
                                <th class="cart-pro-quantity letter-capitalize">{{ 'cart.table.quantity' | trans }}</th>
                                <th class="cart-pro-total-price letter-capitalize">{{ 'cart.table.total' | trans }}</th>
                                <th class="cart-pro-remove"><i class="fa fa-times"></i></th>
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- shopping-cart-table-area-end -->
    <!-- shopping-cart-content-area-start -->
    <div class="shopping-cart-content-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="scca-head">
                        <a class="scb-continue shopping-cart-button hvr-bs" href="{{ path('site.shop_page') }}">{{ 'cart.continue_shopping' | trans }}</a>
                        <a class="scb-update shopping-cart-button hvr-bs update-products" href="#">{{ 'cart.update' | trans }}</a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-sm-6 col-xs-12">
                    <div class="sccb-discount shopping-cart-content-box">
                        <h3 class="sccb-title letter-capitalize">{{ 'cart.promo_coupon' | trans }}</h3>
                        <span class="sccb-shipping-title letter-capitalize">{{ 'cart.promo_coupon_text' | trans }}</span>
                        <div class="sccb-discount-subscribe-box clearfix add-coupon-wrapper hide">
                            <input type="text" name="coupon" id="promo_coupon" value="">
                            <a class="sccb-discount-subscribe shopping-cart-button hvr-bs promo-coupon-btn" href="#">{{ 'cart.add_coupon_btn' | trans }}</a>
                        </div>
                        <div class="sccb-discount-subscribe-box clearfix view-coupon-wrapper hide">
                            <p class="promo-coupon-code-view"></p>
                            <a class="sccb-discount-subscribe shopping-cart-button hvr-bs promo-coupon-remove-btn" href="#">{{ 'cart.remove_coupon_btn' | trans }}</a>
                        </div>
                        <p id="coupon-error-text" class="sccb-discount-error"></p>
                    </div>
                </div>
                <div class="col-md-offset-4 col-md-4 col-sm-offset-6 col-sm-6 col-xs-12">
                    <div class="sccb-cart-total shopping-cart-content-box">
                        <h3 class="sccb-title letter-capitalize">{{ 'cart.total_cost' | trans }}</h3>
                        <div class="sccb-cart-content">
                            <h6 class="text-uppercase total-products-amount">{{ 'cart.total_products' | trans }}:
                                    <span class="total-price"></span>
                            </h6>
                            <h6 class="text-uppercase promo-coupon-amount-holder">{{ 'cart.promo_coupon' | trans }}:
                                <span class="promo-coupon-discount"></span></h6>
                            <h6 class="text-uppercase">{{ 'cart.shipping' | trans }}: <span class="shipping-price"></span></h6>
                            <h6 class="text-uppercase">{{ 'cart.total_shipping' | trans }}:
                                <span class="total-price-shipping"></span>
                            </h6>
                        </div>
                        <div class="sccb-cart-button">
                            <a class="shopping-cart-button hvr-bs text-uppercase next-step-btn" href="{{ path('site.checkout_page') }}">{{ 'cart.next_step' | trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- shopping-cart-content-area-end -->
{% endblock %}

{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/cart.css') }}"/>
{% endblock %}
