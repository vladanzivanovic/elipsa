{% extends 'Site/base.html.twig' %}

{% set titleTrans = 'title.contact_us' | trans %}

{% block title %}{{ titleTrans }}{% endblock %}
{% block bodyClass %}contact-page{% endblock %}

{% import 'Site/Macros/Inputs/formWithLabels.html.twig' as form %}
{% import 'Site/Macros/Inputs/input.html.twig' as inputs %}

{% set ANSWER_OPTIONS = get_class_constants('App\\Entity\\AskUs') %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': titleTrans }], 'activePage': titleTrans}) }}

    <div class="contact-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="contact-form-area">
                        <div class="contact-form-head">
                            <h2>{{ titleTrans }}</h2>
                            <h1>{{ titleTrans }}</h1>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div class="contact-service">
                        <div class="row">
                            <div class="col-md-4 col-sm-6 col-xs-12">
                                <div class="single-contact-service">
                                    <div class="clearfix">
                                        <div class="scs-icon">
                                            <i class="fa fa-building"></i>
                                        </div>
                                        <div class="scs-content">
                                            <h6 class="letter-capitalize">{{ 'about_company' | trans }}</h6>
                                            <p>{{ company_info.settings.full_company_name.value }}
                                                <br> <span class="d-inline-block letter-capitalize">{{ 'contact.company_activity' | trans }}:</span> {{ company_info.settings.company_code.value ~' '~ company_info.settings.company_activity.value }}
                                                <br> <span class="d-inline-block letter-capitalize">{{ 'contact.company_id' | trans }}: </span> {{ company_info.settings.company_id.value }}
                                                <br> <span class="d-inline-block letter-capitalize">{{ 'contact.tax_id' | trans }}: </span> {{ company_info.settings.pib.value }}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12">
                                <div class="single-contact-service">
                                    <div class="clearfix">
                                        <div class="scs-icon">
                                            <i class="fa fa-map-marker"></i>
                                        </div>
                                        <div class="scs-content">
                                            <h6 class="letter-capitalize">{{ 'contact.title.address' | trans }}</h6>
                                            <p>
                                                <span class="d-inline-block letter-capitalize">{{ 'email' | trans }}</span>: {{ company_info.settings.main_email.value }}
                                                <br /><span class="d-inline-block letter-capitalize">{{ 'contact.box.street' | trans }}:</span> {{ company_info.settings.street.value }}
                                                <br /><span class="d-inline-block letter-capitalize">{{ 'contact.box.post_code' | trans }}:</span> {{ company_info.settings.zip_code.value }}
                                                <br /><span class="d-inline-block letter-capitalize">{{ 'contact.box.city' | trans }}:</span> {{ company_info.settings.city.value }}
{#                                                <br /><span class="d-inline-block letter-capitalize">{{ 'contact.box.country' | trans }}:</span> {{ settings.city.value }}#}
{#                                                <br> <span class="d-inline-block letter-capitalize">{{ 'contact.telephone.main' | trans }}</span>: {{ settings.telephone.value }}#}
{#                                                <br> <span class="d-inline-block letter-capitalize">{{ 'contact.telephone.mobile' | trans }}</span>: {{ settings.mobile_phone.value }}#}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12">
                                <div class="single-contact-service">
                                    <div class="clearfix">
                                        <div class="scs-icon">
                                            <i class="fa fa-phone"></i>
                                        </div>
                                        <div class="scs-content">
                                            <h6 class="letter-capitalize">{{ 'contact.title.telephone' | trans }}</h6>
                                            <p>
                                                {% for contact in company_info.office_contacts %}
                                                    {% if false == loop.first %}
                                                        <br>
                                                    {% endif %}

                                                    <span class="d-inline-block letter-capitalize">{{ contact.translations[locale].title }}</span>: {{ contact.telephone }}
                                                {% endfor %}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- contact-area-start -->
    <div class="contact-area ask-us-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-6">
                    <div class="contact-form-area ask-us-form">
                        <div class="contact-form-head">
                            <h2 class="ask-us-title">{{ 'title.ask_us' | trans }}</h2>
                        </div>
                        <div class="contact-form-content">
                            <div class="cf-msg"></div>
                            <form id="ask-us-form">
                                <input id="_csrf_token" type="hidden" name="_csrf_token" value="{{ csrf_token('ask_us_form') }}" />
                                <div class="row">
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.input('contact.form.first_name' | trans ~ ' *', 'first_name', '', 'first_name', '', 'text', null, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.input('contact.form.last_name' | trans ~ ' *', 'last_name', '', 'last_name', '', 'text', null, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.input('contact.form.email' | trans ~ ' *', 'email', '', 'email', '', 'email', null, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.input('contact.form.telephone' | trans, 'telephone', '', 'telephone', '', 'text', null, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.select('contact.form.how_to_contact_you' | trans ~ ' *', 'contact_via', 'contact_via', '', answer_options, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 col-sm-12 col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.input('contact.form.subject' | trans ~ ' *', 'subject', '', 'subject', '', 'text', null, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.textarea('contact.form.message' | trans, 'note', '', 'note', 10, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.button('ask_us_submit', 'submit hvr-bs', 'submit' | trans, 'button') }}
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6">
                    <div class="map-area">
                        <div class="gmap">
                            {{ include('Moduls/googleMaps.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- contact-area-end -->

{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/contact.css') }}"/>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const ADDRESS = ['{{ company_info.settings.street.value }}', '{{ company_info.settings.city.value }}', 'Serbia'];
    </script>
{% endblock %}
