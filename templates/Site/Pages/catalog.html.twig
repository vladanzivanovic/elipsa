{% extends ('Site/base.html.twig') %}

{% block bodyClass %}catalog-page{% endblock %}
{% block title %}{{ 'title.catalog' | trans }}{% endblock %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': 'title.catalog' | trans }], 'activePage': 'title.catalog' | trans }) }}

    <!-- shop-left-sidebar-area-start -->
    <div class="shop-left-sidebar-area">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-xs-12">
                    <div class="order-tracker">
                        <h2 class="ot-title">{{ 'title.catalog' | trans }}</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div class="shop-grid">
                        <div class="shop-grid-contents">
                            <div class="search-criteria"></div>
                            <div class="tab-content">
                                <div id="grid" class="tab-pane fade in active">
                                    <div class="grid-items">
                                        <div class="row">
                                            {% for catalog in catalogues %}
                                                <div class="col-md-4 col-sm-6 col-xs-12 col-fold-6 m-bt-2">
                                                    <div class="h3b-single-banner-4 h3b-single-banner">
                                                        <div class="h3b-img">
                                                            <img src="{{ catalog.images.main.thumb.file }}" alt="{{ default_alt_tag }}">
                                                        </div>
                                                        <div class="h3b-content-banner-4 h3b-content">
                                                            <h3>Katalog</h3>
                                                            <h2>{{ catalog.title }}</h2>
                                                            <a href="{{ path('site.catalog_detail_page', {'_locale' : locale, 'slug': catalog.slug}) }}">{{ 'view' | trans }}</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/product.css') }}"/>
{% endblock %}
