{% extends 'Site/base.html.twig' %}

{% block bodyClass %}product-page{% endblock %}
{% block title %}{{ payload.translations[locale].title }} - Elipsa{% endblock %}

{% block ogTitle %}{{ payload.translations[locale].title }}{% endblock %}
{% block ogImage %}{{ app.request.schemeAndHttpHost ~ payload.media.images[0].file }}{% endblock %}
{% block ogUrl %}{{ app.request.schemeAndHttpHost ~ path(routeName, routeParams) }}{% endblock %}
{% block ogDescription %}{{ payload.translations[locale].description }}{% endblock %}

{% block content %}
{#    {% set product = translation.product %}#}
    {% set prevPage = app.request.server.get('HTTP_REFERER') == path('site.trendy_page') ? path('site.trendy_page') : path('site.shop_page') %}
    {% set prevPageTitle = app.request.server.get('HTTP_REFERER') == path('site.trendy_page') ? 'title.trends' | trans : 'title.shop_page' | trans %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title' : 'title.shop_page' | trans, 'link': prevPage}, {'title': payload.translations[locale].title }], 'activePage': payload.translations[locale].title}) }}

    <!-- single-product-area-start -->
    <div class="single-product-area">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-xs-12">
                    <div class="product-tab-area">
                        <div class="clearfix">
                            <div class="photo-gallery style1 fotorama" data-allowfullscreen="native" data-nav="thumbs" data-auto="false"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xs-12">
                    <div class="single-product-description-area">
                        <h2 class="spd-title">{{ payload.translations[locale].title }}</h2>
                        <p class="spd-price">{{ payload.discount is not null ? payload.discount.price.amount : payload.price.amount }} {{ payload.price.currency }}

                            {% if payload.discount is not null %}
                                <span class="spd-old-price">-{{ payload.price.amount }} {{ payload.price.currency }}</span>
                            {% endif %}
                        </p>
                        {% if payload.discount is not null %}
                            <div class="spd-meta">
                                <div class="spd-meta-type">
                                    <p class="saving-price">{{ 'saving' | trans }} <span>{{ payload.discount.saving.amount }} {{ payload.discount.saving.currency }}</span></p>
                                </div>
                            </div>
                        {% endif %}
                        <p class="spd-text">{{ payload.translations[locale].short_description }}</p>
                        <div class="spd-select-color">
                            <span class="letter-capitalize">{{ 'select.color' | trans }}:</span>
                            <ul>
                                {% for color in payload.colors %}
                                    <li>
                                        <a style="background-color: {{ color.hex }}" href="#" data-color="{{ color.id }}" class="color-btn {{ loop.first ? 'active' : '' }}"></a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="spd-select-size">
                            <span class="letter-capitalize">{{ 'select.size' | trans }}:</span>
                            <ul>
                                {% for size in payload.sizes %}
                                    <li><a href="#" class="size-btn">{{ size.size }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="spd-add-cart">
                            <p class="quantity cart-plus-minus">
                                <input type="text" id="product-quantity" value="1" />
                            </p>
                            <button type="button" class="spd-add-to hvr-bs letter-capitalize {{ true == payload.is_sold ? 'disabled' : '' }}" {{ true == payload.is_sold ? 'disabled="disabled"' : '' }}>
                                {{ 'add_to_cart' | trans }}
                            </button>
                        </div>
                        <div class="spd-meta">
                            <div class="spd-meta-type">
                                <p>SKU: <span>{{ payload.code }} </span></p>
                            </div>
                        </div>
                        <div class="spd-meta">
                            <div class="spd-meta-cat">
                                <span class="letter-capitalize">{{ 'categories' | trans }}:</span>
                                <ul>
                                    {% for category in payload.categories %}
                                        <li><a href="#">{{ category.title }}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <div class="spd-meta">
                            <div class="spd-meta-tags">
                                <span class="letter-capitalize">{{ 'tags' | trans }}:</span>
                                <ul>
                                    {% for tag in payload.tags %}
                                        <li>
                                            <a href="{{ path('site.trendy_page', {'searchData': 'tags' | trans ~ '/' ~ tag[locale].slug }) }}" target="_blank">{{ tag[locale].title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <div class="spd-share">
                            <span class="letter-capitalize">{{ 'share_link' | trans }}:</span>
                            <ul>
                                <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                <li><a href="#"><i class="fa fa-google-plus"></i></a></li>
                                <li><a href="#"><i class="fa fa-rss"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- single-product-area-end -->
    <!-- single-product-tab-area-start -->
    <div class="single-product-tab-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="single-product-tab">
                        <div class="spt-menu">
                            <ul class="spt-tab clearfix">
                                <li class="active"><a data-toggle="tab" href="#pdesc" class="letter-capitalize">{{ 'product.description' | trans }}</a></li>
                                <li><a data-toggle="tab" href="#ainfo" class="letter-capitalize">{{ 'product.material_cleaning' | trans }}</a></li>
                                <li><a data-toggle="tab" href="#size_table" class="letter-capitalize">{{ 'product.size_table' | trans }}</a></li>
                            </ul>
                        </div>
                        <div class="spt-content">
                            <div class="tab-content">
                                <div id="pdesc" class="tab-pane fade in active">
                                    <p>{{ payload.translations[locale].description }}</p>
                                </div>
                                <div id="ainfo" class="tab-pane fade">
                                    <ul id="cleaning" class="col-xs-12">
                                        {% for cleaningIcon in payload.cleaningIcons %}
                                            <li class="col-md-1 col-xs-2">
                                                <span class="cleaning-icons {{ cleaningIcon.icon }}" title="{{ cleaningIcon.icon | trans }}"></span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    <p>{{ payload.translations[locale].cleaning }}</p>
                                </div>
                                <div id="size_table" class="tab-pane fade">
                                    <img src="{{ asset('build/site/images/size_table_'~ locale ~'.jpg') }}">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- single-product-tab-area-end -->
    <!-- related-product-area-start -->
    <div class="related-product-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="related-product-head">
                        <h2 class="related-pro-title letter-capitalize">{{ 'related_products' | trans }}</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="related-pro-carousel owl-carousel">
                    {% import 'Site/Macros/productGrid.html.twig' as productGrid %}
                    {% for relatedProduct in relatedProducts %}
                        {{ productGrid.productGrid(relatedProduct, 'col-xs-12', locale) }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <!-- related-product-area-end -->
{% endblock %}

{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/product.css') }}"/>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const SLUG = '{{ app.request.attributes.get('slug') }}';
        const MEDIA = JSON.parse('{{ payload.media | json_encode() | raw }}');
    </script>
{% endblock %}
