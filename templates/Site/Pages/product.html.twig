{% extends 'Site/base.html.twig' %}

{% block bodyClass %}product-page{% endblock %}
{% block title %}{{ translation.title }} - Elipsa{% endblock %}

{% block content %}
    {% set product = translation.product %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': translation.title }], 'activePage': translation.title}) }}

    <!-- single-product-area-start -->
    <div class="single-product-area">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-xs-12">
                    <div class="product-tab-area">
                        <div class="clearfix">
                            <div class="product-tab-content tab-content">
                                {% for image in images %}
                                    <div id="images-{{ image.fileName }}" data-color="{{ image.color }}" class="large-image tab-pane fade {{ loop.first ? 'in active' : '' }}">
                                        <a href="{{ image.image_link }}" data-fancybox="images-{{ image.color }}">
                                            <i class="fa fa-search-plus"></i>
                                            <img src="{{ image.image_link }}" alt="{{ default_alt_tag }}">
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="product-tab-menu">
                                <ul class="product-tab">
                                    {% for image in images %}
                                        <li class="thumb-image {{ loop.first ? 'active' : '' }}" data-color="{{ image.color }}" data-image="{{ image.fileName }}">
                                            <a data-toggle="tab" href="#images-{{ image.fileName }}"><img src="{{ image.image_link_thumb }}" alt="{{ default_alt_tag }}"></a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xs-12">
                    <div class="single-product-description-area">
                        <h2 class="spd-title">{{ translation.title }}</h2>
                        <p class="spd-price">{{ product.discount > 0 ? product.discount : product.price }} RSD

                            {% if product.discount > 0 %}
                                <span class="spd-old-price">{{ product.price }} RSD</span>
                            {% endif %}
                        </p>
                        <p class="spd-text">{{ translation.shortDescription }}</p>
{#                        <ul class="spd-list">#}
{#                            <li>Satisfaction 100% Guaranteed</li>#}
{#                            <li>Free shipping on orders over $99</li>#}
{#                            <li>14 day easy Return</li>#}
{#                        </ul>#}
                        <div class="spd-select-color">
                            <span class="letter-capitalize">{{ 'select.color' | trans }}:</span>
                            <ul>
                                {% for color in colors %}
                                    <li>
                                        <a style="background-color: {{ color.hex }}" href="#" data-color="{{ color.id }}" class="color-btn {{ loop.first ? 'active' : '' }}"></a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="spd-select-size">
                            <span class="letter-capitalize">{{ 'select.size' | trans }}:</span>
                            <ul>
                                {% for size in sizes %}
                                    <li><a href="#" class="size-btn">{{ size.size }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="spd-add-cart">
                            <p class="quantity cart-plus-minus">
                                <input type="text" id="product-quantity" value="1" />
                            </p>
                            <button type="button" class="spd-add-to hvr-bs letter-capitalize">{{ 'add_to_cart' | trans }}</button>
                        </div>
                        <div class="spd-meta">
                            <div class="spd-meta-type">
                                <p>SKU: <span>{{ product.code }} </span></p>
                            </div>
                        </div>
                        <div class="spd-meta">
                            <div class="spd-meta-cat">
                                <span class="letter-capitalize">{{ 'categories' | trans }}:</span>
                                <ul>
                                    {% for category in productCategories %}
                                        <li><a href="#">{{ category.title }}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <div class="spd-meta">
                            <div class="spd-meta-tags">
                                <span class="letter-capitalize">{{ 'tags' | trans }}:</span>
                                <ul>
                                    {% for tag in tags %}
                                        <li><a href="#">{{ tag.label }}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <div class="spd-share">
                            <span class="letter-capitalize">{{ 'share_link' | trans }}:</span>
                            <ul>
                                <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                <li><a href="#"><i class="fa fa-google-plus"></i></a></li>
                                <li><a href="#"><i class="fa fa-rss"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- single-product-area-end -->
    <!-- single-product-tab-area-start -->
    <div class="single-product-tab-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="single-product-tab">
                        <div class="spt-menu">
                            <ul class="spt-tab clearfix">
                                <li class="active"><a data-toggle="tab" href="#pdesc" class="letter-capitalize">{{ 'product.description' | trans }}</a></li>
                                <li><a data-toggle="tab" href="#ainfo" class="letter-capitalize">{{ 'product.material_cleaning' | trans }}</a></li>
                                <li><a data-toggle="tab" href="#size_table" class="letter-capitalize">{{ 'product.size_table' | trans }}</a></li>
                            </ul>
                        </div>
                        <div class="spt-content">
                            <div class="tab-content">
                                <div id="pdesc" class="tab-pane fade in active">
                                    <p>{{ translation.description }}</p>
                                </div>
                                <div id="ainfo" class="tab-pane fade">
                                    <ul id="cleaning" class="col-xs-12">
                                        {% for icon in cleaningIcons %}
                                            <li class="col-md-1 col-xs-2">
                                                <span class="cleaning-icons {{ icon }}" title="{{ icon | trans }}"></span>
                                            </li>
                                        {% endfor %}
                                    </ul>

                                    <p>{{ translation.cleaning }}</p>
                                </div>
                                <div id="size_table" class="tab-pane fade">
                                    <img src="{{ asset('build/site/images/size_table_'~ locale ~'.jpg') }}">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- single-product-tab-area-end -->
    <!-- related-product-area-start -->
    <div class="related-product-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="related-product-head">
                        <h2 class="related-pro-title letter-capitalize">{{ 'related_products' | trans }}</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="related-pro-carousel owl-carousel">
                    {% import 'Site/Macros/productGrid.html.twig' as productGrid %}
                    {% for relatedProduct in related_products.products %}
                        {{ productGrid.productGrid(relatedProduct, related_products.product_tags[relatedProduct.id] is defined ? related_products.product_tags[relatedProduct.id] : [], related_products.product_colors, related_products.product_sizes, 'col-xs-12') }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <!-- related-product-area-end -->
{% endblock %}

{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/product.css') }}"/>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const SLUG = '{{ app.request.attributes.get('slug') }}';
    </script>
{% endblock %}