{% extends ('Site/base.html.twig') %}

{% set titleTrans = 'text.type.career' | trans %}

{% block bodyClass %}jobs-page{% endblock %}
{% block title %}{{ titleTrans }}{% endblock %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': titleTrans }], 'activePage': titleTrans}) }}

    <!-- shop-left-sidebar-area-start -->
    <div class="shop-left-sidebar-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="shop-grid">
                        <div class="shop-grid-contents">
                            <div class="search-criteria"></div>
                            <div class="tab-content">
                                <div id="grid" class="tab-pane fade in active">
                                    <div class="grid-items">
                                        <div class="row">
                                            {% for job in jobs %}
                                                <div class="col-md-4 col-sm-6 col-xs-6">
                                                    <div class="single-featured-item">
                                                        <div class="sfi-img">
                                                            <a href="{{ path('site.jobs_detail_page', {'slug': job.slug}) }}"><img src="{{ job.image_link_list }}" alt="{{ default_alt_tag }}"></a>
                                                            <a href="{{ path('site.jobs_detail_page', {'slug': job.slug}) }}" class="sfi-img-content sfi-data-content">{{ job.title }}</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/jobs.css') }}"/>
{% endblock %}