{% extends 'Site/base.html.twig' %}

{% set title = 'email.order.overview' | trans %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}order-finish-page{% endblock %}


{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [], 'activePage': title ~' #'~ id}) }}

    <div class="order-tracker-area">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 col-xs-12">
                    <div class="order-tracker">
                        <h2 class="ot-title">{{ title }}</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if is_mobile() %}
        {{ include('Site/Components/orderFinishDataMobile.html.twig') }}
    {% else %}
        {{ include('Site/Components/orderFinishData.html.twig') }}
    {% endif %}
{% endblock %}
{% block pageStyleSheets %}
    {{ encore_entry_link_tags('css/site/pages/orderFinish') }}
{% endblock %}
