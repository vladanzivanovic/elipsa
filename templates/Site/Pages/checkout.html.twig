{% extends 'Site/base.html.twig' %}

{% block bodyClass %}checkout-page{% endblock %}
{% block title %}{{ 'title.cart_personal_data' | trans }}{% endblock %}

{% import 'Site/Macros/Inputs/formWithLabels.html.twig' as form %}
{% import 'Site/Macros/Inputs/input.html.twig' as inputs %}

{% set user = app.user %}
{% set address = user is not null ? user.address : null %}
{% set totalWithShipping = 0 %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [
        {'title': 'cart.name' | trans, 'link': path('site.cart_page')},
        {'title': 'cart.checkout' | trans}
    ], 'activePage': 'cart.checkout' | trans}) }}

    {{ include('Site/Components/cartHeader.html.twig') }}

    <!-- checkout-area-start -->
    <div class="checkout-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="checkout-top">
                        <p>{{ 'checkout.have_account' | trans | raw }}</p>
                    </div>
                </div>
            </div>
            <form id="checkout-form" enctype="multipart/form-data" class="row">
                <div class="col-md-8 col-sm-12 col-xs-12">
                    <div class="billing-address">
                        <h4 class="checkout-box-title letter-capitalize">{{ 'checkout.billing_address' | trans }}</h4>
                        <div class="checkout-billing-address-box">
                            <input id="_csrf_token_checkout" type="hidden" name="_csrf_token" value="{{ csrf_token('order_complete') }}" />
                            <div class="billing-address-input clearfix">
                                {{ form.input('country' | trans ~ ' *', 'country', address is not null ? address.country : '', 'billing_address[country]', '', 'text', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('first_name' | trans ~ ' *', 'firstName', user is not null ? user.firstName : '', 'billing_address[first_name]', '', 'text', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('last_name' | trans ~ ' *', 'lastName', user is not null ? user.lastName : '', 'billing_address[last_name]', '', 'text', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('address' | trans ~ ' *', 'address', address is not null ? address.address : '', 'billing_address[street]', '', 'text', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('city' | trans ~ ' *', 'city', address is not null ? address.city : '', 'billing_address[city]', '', 'text', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('zip_code' | trans ~ ' *', 'zipCode', address is not null ? address.zipCode : '', 'billing_address[zip_code]', '', 'text', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('email' | trans ~ ' *', 'email', user is not null ? user.email : '', 'billing_address[email]', '', 'email', null, '', 'text-uppercase') }}
                            </div>
                            <div class="billing-address-input clearfix">
                                {{ form.input('mobile_telephone' | trans ~ ' *', 'mobilePhone', address is not null ? address.phone : '', 'billing_address[mobile_phone]', '', 'tel', null, '', 'text-uppercase') }}
                            </div>
                            <div class="cbab-create-account">
                                {{ inputs.input('createAccount', '1', 'user[create_account]', '', 'checkbox', '', user is not null ? 'disabled="disabled"' : null) }}
                                <label for="createAccount" class="letter-capitalize">{{ 'create_account' | trans }}?</label>
                                <em id="createAccountError" class="error"></em>
                                <p class="letter-capitalize">{{ 'checkout.login_text' | trans }}</p>
                            </div>
                            <div class="cbab-account-password clearfix">
                                {{ form.input('password' | trans ~ ' *', 'checkoutPassword', '', 'user[password]', '', 'password', 'disabled="disabled"', 'text-uppercase', 'text-uppercase') }}
                            </div>
                            <div class="cbab-order-notes">
                                <p class="text-uppercase">{{ 'checkout.order_notes' | trans }}</p>
                                {{ inputs.input('orderNotes', '', 'order_note', '') }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12 col-xs-12">
                    <div class="your-order-box">
                        <h4 class="checkout-box-title text-uppercase">{{ 'checkout.your_order' | trans }}</h4>
                        <div class="yob-content">
                            <p class="yobc-title text-uppercase">{{ 'checkout.product_total' | trans | raw }}</p>
                            <ul class="product-list">
{#                                {% for product in products %}#}
{#                                    {% set price = product.discount > 0 ? product.discount : product.price %}#}
{#                                    {% set productTotal = product.quantity * price %}#}
{#                                    <li class="clearfix">{{ product.name }}  x {{ product.quantity }} <span>{{ productTotal | number_format(2)  }} RSD</span></li>#}
{#                                {% endfor %}#}
{#                                {% set totalWithDiscount = total %}#}
{#                                {% set totalWithShipping = shipping | trim + total %}#}
{##}
{#                                {% if promo_price is not null %}#}
{#                                    {% set totalWithDiscount = (total - (total * (promo_price / 100))) %}#}
{#                                    {% set shipping = totalWithDiscount >= free_shipping_price ? 0 : shipping_price %}#}
{#                                    {% set totalWithShipping = shipping + totalWithDiscount %}#}
{#                                {% endif %}#}
{##}
                            </ul>
                            <ul>
                                <li id="products-total" class="order-total clearfix">{{ 'cart.total_products' | trans }} <span></span></li>
                                <li id="promo-price" class="order-total clearfix">{{ 'cart.promo_coupon' | trans }} <span></span></li>
                                <li id="shipping-price" class="order-total clearfix">{{ 'cart.shipping' | trans }} <span></span></li>
                                <li id="total-with-shipping" class="order-total clearfix">
                                    {{ 'cart.total_shipping' | trans }}
                                    <span></span>
                                </li>
                            </ul>
                            <div class="create-account-checkout-method">
                                <div class="select-payment-method">
                                    {{ inputs.input('byTaking', constant('App\\Entity\\ShopOrder::PAYMENT_TYPE_ON_DELIVERING'), 'payment_type', '', 'radio') }}
                                    <label for="byTaking" class="letter-capitalize">{{ 'checkout.payment.by_taking' | trans }}</label>
                                </div>
                                <div class="select-payment-method">
                                    {{ inputs.input('creditCard', constant('App\\Entity\\ShopOrder::PAYMENT_TYPE_CREDIT_CARD'), 'payment_type', '', 'radio', '', 'data-show-error-after=yes') }}
                                    <label for="creditCard" class="letter-capitalize">{{ 'checkout.paymeny.credit_card' | trans }}</label>
                                </div>
                                <div class="select-payment-method terms-and-conditions">
                                    {{ inputs.input('termsAndConditions', 1, 'terms_and_conditions', '', 'checkbox', '', 'data-error-after=".terms-and-conditions"') }}
                                    <label for="termsAndConditions" id="termsAndConditionLabel" class="letter-capitalize">{{ 'checkout.checkbox.terms_and_conditions' | trans({'%link%': path('site.use_conditions')}) | raw }}</label>
                                </div>
                                <div class="place-order">
                                    <button type="submit" class="checkout-page-button hvr-bs">{{ 'cart.checkout' | trans }}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <!-- checkout-area-end -->

{#    {{ include('Site/Components/intesaPaymentForm.html.twig') }}#}
{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/checkout.css') }}">
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const INTESA_GATEWAY = '{{ intesa_gateway }}';
    </script>
{% endblock %}
