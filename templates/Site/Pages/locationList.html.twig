{% extends 'Site/base.html.twig' %}

{% set locationTitle = 'title.location' | trans %}
{% block bodyClass %}location-page{% endblock %}
{% block title %}{{ locationTitle }} - Elipsa{% endblock %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': locationTitle }], 'activePage': locationTitle }) }}

    <div class="shop-left-sidebar-area">
        <div class="container">
            <div class="row">
                {% if false == is_mobile() and false == is_tablet() %}
                    <div class="col-md-2 col-sm-12 col-xs-12">
                        <div class="shop-sidebar-area">
                            <div class="sidebar-widget widget-categories">
                                <h4 class="sidebar-title">{{ 'title.location' | trans }}</h4>
                                <div class="sidebar-widget-body">
                                    <div class="location-search">
                                        <input class="location-search-input" type="text" placeholder="{{ 'location.search_text' | trans }}..." />
                                        <button type="button" class="reset-search hide">
                                            <i class="fa fa-times" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <div class="location-list">
                                        {% for place, locations in payload %}
                                            <p class="location-place">{{ place }}</p>
                                            {% for location in locations  %}
                                                {% set trans = location.translations[locale] %}
                                                <div class="sidebar-box location-item" data-id="{{ location.id }}">
                                                    <button class="sidebar-location-button location-btn">
                                                        <p class="location-address">
                                                            {{ place != 'Beograd' and place != 'Belgrade' ? trans.title_text : trans.street }}
                                                        </p>
                                                    </button>
                                                </div>
                                            {% endfor %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="col-md-10 col-sm-12 col-xs-12">
                    <div class="row">
                        {% if is_mobile() or is_tablet() %}
                            <div class="deafult-sorting col-xs-12">
                                <label class="location-list-title">{{ 'title.location' | trans }}</label>
                                <select class="sort-option location-drop-down">
                                    {% for place, locations in payload %}
                                        <optgroup label="{{ place }}">
                                            {% for location in locations %}
                                                {% set trans = location.translations[locale] %}
                                                <option class="text-capitalize" value="{{ location.id }}">
                                                    {{ place != 'Beograd' and place != 'Belgrade' ? trans.title_text : trans.street }}
                                                </option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                    </div>
                    <div class="related-product-area m-t-2-xss">
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="related-product-head">
                                    <h2 class="related-pro-title letter-capitalize">{{ 'location.map' | trans }}</h2>
                                </div>
                                <div class="related-product-body">
                                    {{ include('Moduls/googleMaps.html.twig') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- map-area-start -->
    <div class="map-area">
        <div class="gmap">
        </div>
    </div>
    <!-- map-area-end -->
{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/location.css') }}"/>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const LOCATIONS = JSON.parse('{{ payload | json_encode | raw }}');
    </script>
{% endblock %}
