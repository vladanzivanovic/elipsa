{% extends 'Site/base.html.twig' %}

{% block title%}Blog{% endblock %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': 'Blog' }], 'activePage': 'Blog'}) }}

    {% set selectedTag = app.request.attributes.get('tag') %}

    <!-- blog-area-start -->
    <div class="blog-area">
        <div class="container">
            <div class="row">
                <div class="col-md-9 col-sm-12 col-xs-12">
                    <div class="blogs">
                        {% for blog in blogs %}
                            {% set trans = blog.translations[locale] %}
                            <div class="single-blog">
                                <div class="blog-img">
                                    <a href="{{ path('site.blog_detailed_page', {'slug': trans.slug}) }}"><img src="{{ blog.media.images[0].file }}" alt="{{ trans.title ~ default_alt_tag }}"></a>
                                    <div class="blog-img-content">
                                        <span class="bc-date">{{ blog.date.day }}</span>
                                        <span class="bc-month">{{ blog.date.month }}</span>
                                    </div>
                                </div>
                                <div class="blog-content">
                                    <a class="blog-title" href="{{ path('site.blog_detailed_page', {'slug': trans.slug}) }}">{{ trans.title }}</a>
                                    <p class="blog-text">{{ trans.short_description }}</p>
                                    <a class="blog-read-more letter-capitalize" href="{{ path('site.blog_detailed_page', {'slug': trans.slug}) }}">{{ 'read_more' | trans }}</a>
                                </div>
                            </div>
                        {% endfor %}
                        {{ include('Site/Components/paginate.html.twig') }}
                    </div>
                </div>
                <div class="col-md-3 col-sm-12 col-xs-12">
                    <div class="blog-sidebar">
                        <div class="blog-widget blog-widget-category">
                            <h4 class="bw-title letter-capitalize">{{ 'tags' | trans }}</h4>
                            <ul class="bw-cat-list">
                                <li><a class="tag-btn {{ selectedTag is null ? 'active' : '' }} letter-capitalize" data-search="all" href="#">{{ 'all' | trans }}</a></li>
                                {% for tag in options.tags %}
                                    <li><a class="tag-btn {{ selectedTag is not null and selectedTag == tag.translations[locale].slug ? 'active' : '' }}" data-search="{{ tag.translations[locale].slug }}" href="#">{{ tag.translations[locale].title }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- blog-area-end -->
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_FIRST_PAGE = {{ app.request.attributes.get('page') == 1 ? 1 : 0 }};
        const LINKS = JSON.parse('{{ _web_links | json_encode | raw }}');
    </script>
{% endblock %}
