{% extends ('Site/base.html.twig') %}

{% block bodyClass %}shop-page{% endblock %}
{% block title %}{{ 'title.shop_page' | trans }}{% endblock %}

{% block ogImage %}{{ products|length > 0 ? app.request.schemeAndHttpHost ~ products[0].image.file : defaultOgImage }}{% endblock %}
{% block ogUrl %}{{ app.request.schemeAndHttpHost ~ path(routeName, routeParams) }}{% endblock %}

{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': 'navi.shop' | trans }], 'activePage': 'title.shop_page' | trans}) }}

    <!-- shop-left-sidebar-area-start -->
    <div class="shop-left-sidebar-area">
        <div class="container">
            <div class="row">
                <div class="col-md-3 col-sm-12 col-xs-12">
                    {% if false == is_mobile() and false == is_tablet()  %}
                        {% include 'Site/Components/filter.html.twig' with {filterClass: ''} %}
                    {% endif %}
                </div>
                <div class="col-md-9 col-sm-12 col-xs-12">
                    <div class="shop-grid">
                        <div class="shop-menu clearfix">
                            {% set shopOptions = app_params('shop') %}
                            {% set sortOptions = shopOptions['sort_mapping'] %}
                            <div class="deafult-sorting">
                                <label class="letter-capitalize">{{ 'sort' | trans }}</label>
                                <select class="sort-option">
                                    {% for key, option in sortOptions %}
                                        <option class="text-capitalize" value="{{ key }}" {{ page_options.sort is not null and page_options.sort == key ? 'selected="selected" : ""' }}>{{ key | trans }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="show-product">
                                <label class="letter-capitalize">{{ 'show_per_page' | trans }}</label>
                                {% set showedItems = shopOptions['items_per_page'] %}
                                <select class="limit-product">
                                    {% for showedItem in showedItems %}
                                        <option value="{{ showedItem }}" {{ page_options.limit is not null and page_options.limit == showedItem ? 'selected="selected" : ""' }}>{{ showedItem }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="shop-grid-contents">
                            <div class="search-criteria"></div>
                            <div class="tab-content">
                                <div id="grid" class="tab-pane fade in active">
                                    <div class="grid-items">
                                        <div class="row">
                                            {% import 'Site/Macros/productGrid.html.twig' as productGrid %}
                                            {% set modusParams = is_mobile() ? 2 : 3 %}
                                            {% for productsChunks in products | batch(modusParams) %}
                                                <div class="row m-l-0 m-r-0">
                                                    {% for product in productsChunks %}
                                                        {{ productGrid.productGrid(product, 'col-md-4 col-sm-6 col-xs-6', locale) }}
                                                    {% endfor %}
                                                </div>
                                            {% endfor %}
                                        </div>
                                        {{ include('Site/Components/paginate.html.twig') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if is_mobile() %}
    <!-- shop-left-sidebar-area-end -->
        <div id="myNav" class="overlay">

            <!-- Button to close the overlay navigation -->
            <a href="javascript:void(0)" class="filter-close-icon filter-close">&times;</a>

            <!-- Overlay content -->
            <div class="overlay-content">
                {% include'Site/Components/filter.html.twig' with {filterClass: 'mobile-view'} %}
            </div>

            <div class="btn-wrapper">
                <button type="button" class="filter-close-button filter-close btn-danger">Zatvori</button>
            </div>

        </div>

        <div id="filter-btn-open" class="letter-capitalize"><i class="fa fa-filter" aria-hidden="true"></i></div>
    {% endif %}
{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/shop.css') }}"/>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_FIRST_PAGE = {{ app.request.attributes.get('page') == 1 ? 1 : 0 }};

        const SEARCH_CRITERIA = JSON.parse('{{ search | json_encode | raw }}');
        const PAGE_OPTIONS = JSON.parse('{{ page_options | json_encode | raw }}');
        const PRICES = [{{ filters.price.lowPrice }}, {{ filters.price.highPrice }}];
        const PAGE_OPTIONS_DEFAULT_VALUES = {
            'sort': 'most_selled',
            'limit': {{ app_params('shop')['items_per_page'][0] }},
        };
        const LINKS = JSON.parse('{{ _web_links | json_encode | raw }}');
    </script>
{% endblock %}
