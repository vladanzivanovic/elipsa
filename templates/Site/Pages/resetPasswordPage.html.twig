{% extends 'Site/base.html.twig' %}
{% set titleTrans = 'reset_password.label' | trans %}

{% block title %}{{ titleTrans }}{% endblock %}
{% block bodyClass %}ask-us-page{% endblock %}

{% import 'Site/Macros/Inputs/formWithLabels.html.twig' as form %}
{% import 'Site/Macros/Inputs/input.html.twig' as inputs %}


{% block content %}
    {{ include('Site/Components/breadcrumb.html.twig', {'pages': [{'title': titleTrans }], 'activePage': titleTrans}) }}

    <div class="contact-area">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="contact-form-pre-text">{{ 'reset_password.text' | trans }}</div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div class="contact-form-area">
                        <div class="contact-form-head">
                            <h2>{{ titleTrans }} {{ 'form' | trans }}</h2>
                            <h1>{{ titleTrans }} {{ 'form' | trans }}</h1>
                        </div>
                        <div class="contact-form-content">
                            <div class="cf-msg"></div>
                            <form id="reset_password_form" enctype="multipart/form-data">
                                <input id="_csrf_token" type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password_form') }}" />
                                <input id="token" type="hidden" name="token" value="{{ app.request.attributes.get('resetToken') }}" />
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="cfc-input-box col-md-6 col-sm-6 col-xs-12">
                                            {{ form.input('password' | trans ~ ' *', 'password', '', 'password', '', 'password', null, '', 'text-uppercase') }}
                                        </div>
                                        <div class="cfc-input-box col-md-6 col-sm-6 col-xs-12">
                                            {{ form.input('Re_password' | trans ~ ' *', 'repeat_password', '', 'repeat_password', '', 'password', null, '', 'text-uppercase') }}
                                        </div>
                                    </div>
                                    <div class="col-xs-12">
                                        <div class="cfc-input-box">
                                            {{ form.button('reset_password_submit', 'submit hvr-bs', 'submit' | trans, 'button') }}
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block pageStyleSheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('build/css/site/pages/loyalty.css') }}">
{% endblock %}