{% extends ('Site/base.html.twig') %}

{% block bodyClass %}home{% endblock %}

{% block content %}
    <!-- home2-slider-start -->
    <div class="home3-slider-container">
        <!-- Slider Image -->
        <div id="home3_slider" class="nivoSlider slider-image">
            {% for slider in sliders %}
                <img src="{{ is_mobile() ? slider.mobile_image_link : slider.image_link }}" alt="" title="#{{ slider.id }}" />
            {% endfor %}
        </div>
        {% for slider in sliders %}
            <!-- Slider Caption {{ slider['id'] }} -->
            <div id="{{ slider['id'] }}" class="nivo-html-caption slider-caption-{{ slider['id'] }}">
                <div class="slider-progress"></div>
                <div class="container">
                    <div class="row">
                        <div class="col-xs-12 {{ 'text-' ~ slider['position'] }}">
                                <div class="slide3-text">
                                    <div class="middle-text">
                                        {% if slider['description'][0] is defined %}
                                        <div class="cap-dec animated bounceIn">
                                            <h6>{{ slider['description'][0] is defined ? slider['description'][0] : '&nbsp;' }}</h6>
                                        </div>
                                        {% endif %}
                                        {% if slider['description'][1] is defined %}
                                        <div class="cap-title animated zoomIn">
                                            <h2>{{ slider['description'][1] is defined ? slider['description'][1] | capitalize : '&nbsp;' }}</h2>
                                            {% endif %}
                                        </div>
                                        {% if slider['description'][2] is defined %}
                                        <div class="cap-title-2 animated zoomIn">
                                            <h3>{{ slider['description'][2] is defined ? slider['description'][2] : '&nbsp;' }}</h3>
                                        </div>
                                        {% endif %}
                                        <div class="cap-text animated zoomIn">
                                            {% if slider['description'][3] is defined %}
                                            <p>{{ slider['description'][3] is defined ? slider['description'][3] : '&nbsp;' }}</p>
                                            {% endif %}
                                            {% if slider['description'][4] is defined %}
                                            <span>{{ slider['description'][4] is defined ? slider['description'][4] : '&nbsp;' }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="cap-view animated bounceInUp">
                                            <a class="hvr-bs" href="{{ slider['button_link'] }}">{{ slider['button_text'] }}</a>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <!-- home2-slider-end -->
    <!-- featured-itema-area-start -->
    {% if products[2] is defined %}
    <div class="home-2-featured-item-area">
        <div class="container">

            <div class="featured-items">
                <div>
                    <div class="featured-all">
                        <div class="fi-row">
                            <div class="row">
                                <div id="top_carousel" class="feature-pro-carousel owl-carousel">
                                    {% import 'Site/Macros/productGrid.html.twig' as productGrid %}
                                    {% for product in products[2] %}
                                        {{ productGrid.productGrid(product, product_tags[product.id] is defined ? product_tags[product.id] : [], product_colors, product_sizes, 'col-xs-12', locale) }}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    <!-- featured-itema-area-end -->
    <!-- home3-banner-area-start -->
    <div class="home3-banner-area">
        <div class="container">
            <div class="row">
                {% if banners[1] is defined %}
                    {% set firstBanner = banners[1] %}
                    <div class="col-md-4 col-sm-6 col-xs-12">
                        <div class="h3b-single-banner-4 h3b-single-banner">
                            <div class="h3b-img">
                                <img src="{{ firstBanner['image_link'] }}" alt="">
                            </div>
                            <div class="h3b-content-banner-4 h3b-content">
                                <h3>{{ firstBanner['description'][0] is defined ? firstBanner['description'][0] : '&nbsp;' }}</h3>
                                <h2>{{ firstBanner['description'][1] is defined ? firstBanner['description'][1] : '&nbsp;' }}</h2>
                                <a href="{{ firstBanner['button_link'] }}">{{ firstBanner['button_text'] }}</a>
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="col-md-4 hidden-sm col-xs-12 home-middle-banners">
                    {% if banners[2] is defined %}
                        {% set secondBanner = banners[2] %}
                        <div class="h3b-single-banner-3 h3b-single-banner">
                            <div class="h3b-img">
                                <img src="{{ secondBanner['image_link'] }}" alt="">
                            </div>
                            <div class="h3b-content-banner-3 h3b-content">
                                <h2>{{ secondBanner['description'][0] is defined ? secondBanner['description'][0] : '&nbsp;' }}</h2>
                                <a href="{{ secondBanner['button_link'] }}">{{ secondBanner['button_text'] }}</a>
                            </div>
                        </div>
                    {% endif %}
                    {% if banners[3] is defined %}
                        {% set thirdBanner = banners[3] %}
                        <div class="h3b-single-banner-3 h3b-single-banner">
                            <div class="h3b-img">
                                <img src="{{ thirdBanner['image_link'] }}" alt="">
                            </div>
                            <div class="h3b-content-banner-3 h3b-content">
                                <h2>{{ thirdBanner['description'][0] is defined ? thirdBanner['description'][0] : '&nbsp;' }}</h2>
                                <a href="{{ thirdBanner['button_link'] }}">{{ thirdBanner['button_text'] }}</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
                {% if banners[4] is defined %}
                    {% set fourthBanner = banners[4] %}
                    <div class="col-md-4 col-sm-6 col-xs-12">
                        <div class="h3b-single-banner-4 h3b-single-banner">
                            <div class="h3b-img">
                                <img src="{{ fourthBanner['image_link'] }}" alt="">
                            </div>
                            <div class="h3b-content-banner-4 h3b-content">
                                <h3>{{ fourthBanner['description'][0] is defined ? fourthBanner['description'][0] : '&nbsp;' }}</h3>
                                <h2>{{ fourthBanner['description'][1] is defined ? fourthBanner['description'][1] : '&nbsp;' }}</h2>
                                <a href="{{ fourthBanner['button_link'] }}">{{ fourthBanner['button_text'] }}</a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <!-- home3-banner-area-end -->
    <!-- featured-itema-area-start -->
    {% if products[1] is defined %}
        <div class="home-2-featured-item-area">
            <div class="container">

                <div class="featured-items">
                    <div>
                        <div class="featured-all">
                            <div class="fi-row">
                                <div class="row">
                                    <div id="bottom_carousel" class="feature-pro-carousel owl-carousel">
                                        {% import 'Site/Macros/productGrid.html.twig' as productGrid %}
                                        {% for product in products[1] %}
                                            {{ productGrid.productGrid(product, product_tags[product.id] is defined ? product_tags[product.id] : [], product_colors, product_sizes, 'col-xs-12', locale) }}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    <!-- featured-itema-area-end -->
    <!-- home3-newsletter-area-start -->
    {% set loyaltyBanner = banner(2, is_mobile() ? 'loyalty_banner_mobile' : 'loyalty_banner', locale, is_mobile()) %}
    {% set bannerLink = "background: rgba(0, 0, 0, 0) url("~ loyaltyBanner.image_link ~") no-repeat scroll left top / cover" %}
    <div class="home3-newsletter-area" style="{{ bannerLink }}">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="h3-newsletter-left">
                        <h3 class="h3-nl-title">Elipsa Elite Club</h3>
                        <p class="h3-nl-text">Posebna si uz našu karticu</p>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="h3-newsletter-form">
                        <form action="#">
                            <div class="h3-newsletter-input">
                                <a href="{{ path('site.loyalty', {'_locale': locale}) }}" class="hvr-bs">{{ 'login.btn' | trans }}</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- home3-newsletter-area-end -->
{% endblock %}
{% block pageStyleSheets %}
    {{ encore_entry_link_tags('css/site/pages/home') }}
{% endblock %}