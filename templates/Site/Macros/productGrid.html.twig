{% macro productGrid(product, class, locale, countryDefaultLocale) %}
    <div class="{{ class }}">
        <div class="single-featured-item">
            <div class="sfi-img">
                <a href="{{ path('site.product_page', {'slug': product.translations[locale].slug}) }}">
                    <img src="{{ product.image.file }}" alt="{{ default_alt_tag }}">
                </a>
                {% if product.options[countryDefaultLocale].is_sold == true %}
                    <a href="{{ path('site.product_page', {'slug': product.translations[locale].slug}) }}">
                        <svg class='svg-stroke product-sold' viewBox='0 -0.2 6.5 15' preserveAspectRatio='none'>
                            <line x1="7" y1="-1" x2="-1" y2="11" stroke="#a70303" stroke-width=".6" stroke-opacity="1"></line>
                            <text x="0" y="8" font-size="0.04em" textLength="9em" transform="translate(-4.25, 1.8) rotate(303)" font-family="'Montserrat', sans-serif" font-weight="bold" letter-spacing="0" fill="white">{{ 'sold' | trans }}</text>
                        </svg>
                    </a>
                {% endif %}
                {% if product.options[countryDefaultLocale].discount is not null %}
                    <div class="sfi-img-banner product-discount">
                        <span>-{{ product.options[countryDefaultLocale].discount.percentage }} %</span>
                    </div>
                {% endif %}
                <div class="sfi-img-content sfi-data-content">
                    <p class="letter-capitalize">{{ 'available_colors' | trans }}:</p>
                    <ul class="sfi-data-color">
                        {% for hex, color in product.colors %}
                            <li>
                                <a style="background-color: {{ hex }}" href="{{ path('site.product_page', {'slug': product.translations[locale].slug}) }}"></a>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="letter-capitalize">{{ 'available_sizes' | trans }}:</p>
                    <ul class="sizes">
                        {% for productSize in product.options[countryDefaultLocale].sizes %}
                            <li>
                                <a href="{{ path('site.product_page', {'slug': product.translations[locale].slug}) }}" class="{{ productSize.quantity <= 0 ? 'unavailable' : '' }}">{{ productSize.size }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="sfi-content">
                <div class="sfi-buttons">
                    <ul class="clearfix">
                        <li><a href="#" class="toggle-wish-list" data-product-id="{{ product.id }}" data-page="shop"><i class="fa {{ product.is_wish == true ? 'fa-heart' : 'fa-heart-o' }}"></i></a></li>
                        <li><a href="{{ path('site.product_page', {'slug': product.translations[locale].slug}) }}"><i class="fa fa-eye"></i></a></li>
                    </ul>
                </div>
                <div class="sfi-name-cat">
                    <a class="sfi-name" href="{{ path('site.product_page', {'slug': product.translations[locale].slug}) }}">{{ product.translations[locale].title }}</a>
                </div>
                <div class="sfi-price-rating">
                    {% if product.options[countryDefaultLocale].discount is not null %}
                        <p class="sfi-old-price">-{{ product.options[countryDefaultLocale].price.amount }} {{ product.options[countryDefaultLocale].price.currency }}</p>
                        <div class="discount-price">
                            <p class="sfi-price text-uppercase">
                                <span>{{ product.options[countryDefaultLocale].discount.price.amount }} {{ product.options[countryDefaultLocale].price.currency }}</span>
                            </p>
                            <p class="price-saving">{{ 'saving' | trans }} {{ product.options[countryDefaultLocale].discount.saving.amount }} {{ product.options[countryDefaultLocale].discount.saving.currency }}</p>
                        </div>
                    {% else %}
                        <p class="sfi-price text-uppercase">
                            <span>{{ product.options[countryDefaultLocale].price.amount }} {{ product.options[countryDefaultLocale].price.currency }}</span>
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
