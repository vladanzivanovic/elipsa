{% macro childNav(categories) %}
    <ul class="child-submenu">
        {% for category in categories %}
            <li class="{{ category.children is defined ? 'bold' : '' }}">
                <a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ category.slug }) }}">{{ category.title }}</a>
                {% if category.children is defined %}
                    {{ self.childNav(category.children) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% macro mobileChildNav(categories) %}
    <ul>
        {% for category in categories %}
            <li>
                <a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ category.slug }) }}">{{ category.title }}</a>
                {% if category.children is defined %}
                    {{ self.mobileChildNav(category.children) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}