{% macro chat() %}
    <!-- Load Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    {% cspscript %}

        <script nonce="{{ csp_nonce('script') }}" crossorigin="anonymous">
            window.fbAsyncInit = function() {
                FB.init({
                    xfbml            : true,
                    version          : 'v7.0'
                });
            };

            (function(d, s, id) {
                var js, fjs = d.getElementsByTagName(s)[0];
                if (d.getElementById(id)) return;
                js = d.createElement(s); js.id = id;
                js.src = 'https://connect.facebook.net/'+LANG_MAPPER[LOCALE]+'/sdk/xfbml.customerchat.js';
                fjs.parentNode.insertBefore(js, fjs);
            }(document, 'script', 'facebook-jssdk'));
        </script>

    {% endcspscript %}


    <!-- Your Chat Plugin code -->
    <div class="fb-customerchat"
         attribution=setup_tool
         page_id="{{ fb_id }}"
         theme_color="#a70303"
         logged_in_greeting="{{ 'chat.message.greeting' | trans }}"
         logged_out_greeting="{{ 'chat.message.greeting' | trans }}">
    </div>
{% endmacro %}