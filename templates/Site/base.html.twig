{% set locale = app.request.attributes.get('_locale', default_locale) %}
{% set user = app.user %}
{% set routeName = app.request.attributes.get('_route') %}
{% set siteSettings = site_settings() %}
{% set transUrls = languages %}
{% set langOptions = [] %}
{% set countryDefaultLocale = default_locale %}
{% set mediaDevice = is_mobile() ? 'mobile' : 'desktop' %}

{% for countryCode, country in countries %}
    {% if app.request.host == country.host %}
        {% set countryDefaultLocale = countryCode %}
    {% endif %}
{% endfor %}

{% set languageOptionsByCountry = languages_options(countryDefaultLocale) %}

{% set defaultOgImage = app.request.schemeAndHttpHost ~ asset('build/site/images/logo/logo_og_'~countryDefaultLocale~'.jpg') %}

{% if routeName is null %}
    {% set routeName = 'site.home_page' %}
{% endif %}

{% set routeParams = app.request.attributes.get('_route_params') is not null ? app.request.attributes.get('_route_params') : {'_locale': default_locale} %}
{% set query = app is not null and app.request.query.all is not null ? app.request.query.all : [] %}

{% if app is not null and (app.request.attributes.get('_route_params') is not null or app.request.query.all is not empty) %}
    {% set routeParams = routeParams|merge(query) %}
{% endif %}

{% import 'Site/Macros/externalServices.html.twig' as externals %}

<!DOCTYPE html>
<html lang="{{ locale|split('_')[0] }}">

<head>
    <!--- Basic Page Needs  -->
    <meta charset="utf-8">
    <title>{% block title %}{{ 'default_title' | trans }}{% endblock %}</title>
    <meta name="description" content="Jedinstven dizajn, savršeni krojevi i mnogo ljubavi utkane u kvaltetne i pažljivo birane materijale je ono sto opisuje Elipsu. Ključ elegancije za sve savremene, poslovne žene. - ELIPSA">
    <meta name="author" content="Vladan Zivanovic">
    <meta name="keywords" content="moda fashion clothing elipsa modna kuća žena elegancija woman elegance">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Mobile Specific Meta  -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <meta property="og:title" content="{% block ogTitle %}{% endblock %} ELIPSA">
    <meta property="og:image" content="{% block ogImage %}{{ defaultOgImage }}{% endblock %}">
    <meta property="og:url" content="{% block ogUrl %}{{ app.request.schemeAndHttpHost }}{% endblock %}">
    <meta property="og:site_name" content="ELIPSA">
    <meta property="og:description" content="{% block ogDescription %}Jedinstvena elegancija za savremenu poslovnu damu."{% endblock %}">
    <meta property="og:type" content="website">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Raleway:300,400,500,700" rel="stylesheet">
    <!-- CSS -->

    {% block stylesheets %}
        {{ encore_entry_link_tags('css/site/app') }}
    {% endblock %}
    {% block pageStyleSheets %}{% endblock %}

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="57x57" href="{{ asset('build/site/images/favicon/apple-icon-57x57.png') }}">
    <link rel="apple-touch-icon" sizes="60x60" href="{{ asset('build/site/images/favicon/apple-icon-60x60.png') }}">
    <link rel="apple-touch-icon" sizes="72x72" href="{{ asset('build/site/images/favicon/apple-icon-72x72.png') }}">
    <link rel="apple-touch-icon" sizes="76x76" href="{{ asset('build/site/images/favicon/apple-icon-76x76.png') }}">
    <link rel="apple-touch-icon" sizes="114x114" href="{{ asset('build/site/images/favicon/apple-icon-114x114.png') }}">
    <link rel="apple-touch-icon" sizes="120x120" href="{{ asset('build/site/images/favicon/apple-icon-120x120.png') }}">
    <link rel="apple-touch-icon" sizes="144x144" href="{{ asset('build/site/images/favicon/apple-icon-144x144.png') }}">
    <link rel="apple-touch-icon" sizes="152x152" href="{{ asset('build/site/images/favicon/apple-icon-152x152.png') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('build/site/images/favicon/apple-icon-180x180.png') }}">
    <link rel="icon" type="image/png" sizes="192x192"  href="{{ asset('build/site/images/favicon/android-icon-192x192.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('build/site/images/favicon/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('build/site/images/favicon/favicon-96x96.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('build/site/images/favicon/favicon-16x16.png') }}">
    <link rel="manifest" href="{{ asset('build/site/images/favicon/manifest.json') }}">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="{{ asset('build/site/images/favicon/ms-icon-144x144.png') }}">
    <meta name="theme-color" content="#ffffff">    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

    {% if app.environment == 'prod' %}
        {{ externals.googleAnalytics() }}
    {% endif %}
</head>

<body data-spy="scroll" data-target="#scroll-menu" data-offset="100" class="{{ is_mobile() or is_tablet() ? 'mobile' : '' }} {% block bodyClass %}{% endblock %} eupopup eupopup-bottom">
    <div id="preloader"></div>

    {% set navigationMenu = navigation_menu(locale) %}
    {% set navigationTagsSeasson = navigation_tags(constant('App\\Entity\\Tags::PRODUCT_TYPE_SEASON')) %}
    {% set navigationTagsCollection = navigation_tags(constant('App\\Entity\\Tags::PRODUCT_TYPE_COLLECTION')) %}

    <!-- header-start -->
    <header>
        {{ include('Site/Components/headerTop.html.twig') }}
        {{ include('Site/Components/headerBottom.html.twig') }}
    </header>
    <!-- header-end -->

    {% block content %}{% endblock %}

    <!-- footer-start -->
    <footer>
        {{ include('Site/Components/footerTop.html.twig') }}
        {{ include('Site/Components/footerBottom.html.twig') }}
    </footer>

    {% import 'Site/Macros/popUp.html.twig' as popup %}

    {{ popup.news_letter('news_letter', locale, languageOptionsByCountry, mediaDevice) }}

    {{ popup.popup_banner(constant('App\\Entity\\Banner::TYPE_POP_UP'), 'pop_up', locale, mediaDevice, locale, 1) }}
    <!-- footer-end -->
    {% block javascripts %}
        <script nonce="{{ csp_nonce('script') }}" type="text/javascript">
            const LOCALE = '{{ locale }}';
            const COUNTRY_DEFAULT_LOCALE = '{{ countryDefaultLocale }}';
            const ROUTE_NAME = '{{ routeName }}';
            const IS_MOBILE = window.matchMedia("only screen and (max-width: 760px)").matches;
            const GOOGLE_RECAPTCHA_KEY_SITE  = '{{ 'GOOGLE_RECAPTCHA_KEY_SITE' | getenv }}';
            const APP_ENV = '{{ 'APP_ENV' | getenv }}';
            const SENTRY_DSN = '{{ 'SENTRY_JAVASCRIPT_DSN' | getenv }}';
            const NOTIFICATION_TYPES = JSON.parse('{{ get_class_constants('App\\Entity\\Notification') | json_encode() | raw }}');
            const NO_SIZE = '{{ constant('App\\Entity\\ProductSize::NO_SIZE') }}';
            const SITE_INFO_TEXT = JSON.parse('{{ siteInfoText | json_encode() | raw }}');
            const DEFAULT_ALT_TAG = '{{ default_alt_tag }}';

            window.USER = null;

            {% if user is not null %}
                window.USER = {
                    id: {{ user.id }},
                };
            {% endif %}

            window.Messages = {{ app.session.flashBag.get('message')|json_encode|raw }};
        </script>
        <script type="text/javascript" src="{{ asset('bundles/bazingajstranslation/js/translator.min.js') }}"></script>
        <script type="text/javascript" src="{{ url('bazinga_jstranslation_js', { 'domain': 'messages', 'locales': 'rs,en' }) }}"></script>
        <script type="text/javascript" src="{{ url('bazinga_jstranslation_js', { 'domain': 'validators', 'locales': 'rs,en' }) }}"></script>
        {{ encore_entry_script_tags('js/site/core') }}
        <script type="text/javascript" src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
        <script type="text/javascript" src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
    {% endblock %}
    {% block pageJavascript %}{% endblock %}
    {{ externals.chat() }}
</body>
</html>
