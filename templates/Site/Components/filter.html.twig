{% import 'Site/Macros/sideBar.html.twig' as childNavList %}

<div class="shop-sidebar-area {{ filterClass }}">
    <div class="sidebar-widget widget-categories">
        <h4 class="sidebar-title">{{ 'categories' | trans }}</h4>
        {% for main in navigationMenu %}
            <div class="sidebar-box">
                {% if main.children is defined %}
                    <div class="sidebar-accordion-button">
                        <a class="category-btn {{ search.categories is defined and main.slug in search.categories ? 'active' : '' }}" href="#" data-search-name="categories" data-search="{{ main.slug }}"> {{ main.title }}</a>
                        <button data-toggle="collapse" data-target="#{{ main.id }}"></button>
                    </div>

                    <ul class="sidebar-list sidebar-list__categories collapse in" id="{{ main.id}}">
                        {% for child in main.children %}
                            <li>
                                {% if child.children is defined %}
                                    {{ childNavList.childCategory(child, search.categories is defined ? search.categories : []) }}
                                {% else %}
                                    <a class="category-btn {{ search.categories is defined and child.slug in search.categories ? 'active' : '' }}" href="#" data-search-name="categories" data-search="{{ child.slug }}">{{ child.title }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <button class="sidebar-category-button category-btn {{ search.categories is defined and main.slug in search.categories ? 'active' : '' }}" data-search-name="categories" data-search="{{ main.slug }}">{{ main.title }}</button>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    <div class="sidebar-widget widget-shop-by">
        <h4 class="sidebar-title">{{ 'filters' | trans }}</h4>
        <div class="sidebar-box">
            <button class="sidebar-accordion-button collapsed" data-toggle="collapse" data-target="#price">
                {{ 'filter_text.price' | trans }}
                <span class="filter-counter"></span>
            </button>
            <div id="price" class="priceslider collapse">
                <p>
                    <input type="text" id="filter-price" readonly>
                </p>
                <div id="shop-slider-range"></div>
            </div>
        </div>
        <div class="sidebar-box">
            <button class="sidebar-accordion-button collapsed" data-toggle="collapse" data-target="#size">
                {{ 'filter_text.sizes' | trans }}
                <span class="filter-counter"></span>
            </button>
            <ul id="size" class="sidebar-list collapse">
                {% for size in filters.sizes %}
                    <li><a href="#" class="size-btn {{ search.sizes is not null and size.title in search.sizes ? 'active' : '' }}" data-search-name="sizes" data-search="{{ size.title }}">{{ size.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        <div class="sidebar-box">
            <button class="sidebar-accordion-button collapsed" data-toggle="collapse" data-target="#collection">
                {{ 'filter_text.collections' | trans }}
                <span class="filter-counter"></span>
            </button>
            <ul id="collection" class="sidebar-list collapse">
                {% for collectionTag in filters.collections %}
                    <li><a href="#" class="{{ search.collections is not null and collectionTag[locale].slug in search.collections ? 'active' : '' }}" data-search-name="collections" data-search="{{ collectionTag[locale].slug }}">{{ collectionTag[locale].title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        <div class="sidebar-box">
            <button class="sidebar-accordion-button collapsed" data-toggle="collapse" data-target="#season">
                {{ 'filter_text.seasons' | trans }}
                <span class="filter-counter"></span>
            </button>
            <ul id="season" class="sidebar-list collapse">
                {% for seasonTag in filters.seasons %}
                    <li><a href="#" class="{{ search.seasons is not null and seasonTag[locale].title in search.seasons ? 'active' : '' }}" data-search-name="seasons" data-search="{{ seasonTag[locale].slug }}">{{ seasonTag[locale].title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        <div class="sidebar-box">
            <button class="sidebar-accordion-button collapsed" data-toggle="collapse" data-target="#attribute">
                {{ 'filter_text.attributes' | trans }}
                <span class="filter-counter"></span>
            </button>
            <ul id="attribute" class="sidebar-list collapse">
                {% for attribute in filters.attributes %}
                    <li><a href="#" class="{{ search.attributes is not null and attribute[locale].title in search.attributes ? 'active' : '' }}" data-search-name="attributes" data-search="{{ attribute[locale].slug }}">{{ attribute[locale].title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        <div class="sidebar-box">
            <button class="sidebar-accordion-button collapsed" data-toggle="collapse" data-target="#color">
                {{ 'filter_text.colors' | trans }}
                <span class="filter-counter"></span>
            </button>
            <ul id="color" class="sidebar-list collapse">
                {% for color in filters.colors %}
                    <li><a class="color-box color-btn {{ search.colors is not null and color.slug in search.colors ? 'active' : '' }}" href="#" data-search-name="colors" data-search="{{ color.slug }}"><span class="color" style="background-color: {{ color.hex }}"></span> {{ color.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
