<p style="white-space: normal">
    <span style="font-size: 12px">{{ office_info.settings.site_name.value }}</span>
    <br class="empty-node">
    <a href="{{ url('site.home_page') }}" target="_blank"><span style="font-size: 12px">{{ url('site.home_page') }}</span></a>
</p>
<p class="last-child" style="white-space: normal">
    <strong><span
                style="font-size: 12px">{{ 'email.order.seller.account' | trans }}: </span></strong>
    <span
            style="font-size: 12px">
        {{ office_info.settings.account_number.value }}
    </span><br>
    {% for contact in office_info.office_contacts %}
        {% if false == loop.first %}
            <br>
        {% endif %}
        <strong>
            <span style="font-size: 12px">{{ contact.translations[locale].title }}:</span>
        </strong>
        <span style="font-size: 12px"> {{ contact.telephone }}</span>
    {% endfor %}
    <br><strong><span
                style="font-size: 12px">E-mail:</span></strong><span
            style="font-size: 12px"> {{ office_info.settings.main_email.value }}</span>
</p>
