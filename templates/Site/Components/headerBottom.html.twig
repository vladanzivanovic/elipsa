    {% import 'Site/Macros/navigation.html.twig' as childNavList %}
<div class="menu-area hidden-sm hidden-xs">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="menu">
                    <nav>
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.about_us' | trans }}</a>
                                <ul class="menu-dropdown">
                                    <li><a href="{{ path('site.loyalty') }}">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="#">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <div class="mega-menu-area">
                                    <div class="row">
                                        {% for main in categories %}
                                            <div class="col-md-4">
                                                <div class="mega-menu-part">
                                                    <div class="mega-menu-content">
                                                        <a class="mega-menu-title" href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ main.slug }) }}">{{ main.title }}</a>
                                                        {% if main.children is defined %}
                                                            <ul>
                                                                {% for child in main.children %}
                                                                    <li class="sub-menu-holder"><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ child.slug }) }}">{{ child.title }}</a>
                                                                        {% if child.children is defined %}
                                                                           {{ childNavList.childNav(child.children) }}
                                                                        {% endif %}
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </li>
                            <li><a href="{{ path('site.trendy_page') }}">{{ 'navi.trends' | trans }}</a>
                                <div class="mega-menu-area">
                                    <div class="row">
                                        {% for main in categories %}
                                            <div class="col-md-4">
                                                <div class="mega-menu-part">
                                                    <div class="mega-menu-content">
                                                        <a class="mega-menu-title" href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ main.slug }) }}">{{ main.title }}</a>
                                                        {% if main.children is defined %}
                                                            <ul>
                                                                {% for child in main.children %}
                                                                    <li class="sub-menu-holder"><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ child.slug }) }}">{{ child.title }}</a>
                                                                        {% if child.children is defined %}
                                                                           {{ childNavList.childNav(child.children) }}
                                                                        {% endif %}
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </li>
                            <li><a href="{{ path('site.blog_list_page') }}">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page') }}">{{ 'navi.locations' | trans }}</a></li>
                            <li><a href="{{ path('site.ask_us') }}">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.contact' | trans }}</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="col-md-4">
                <div class="menu-area-right">
                    <div class="my-account">
                        <a href="{{ path('site.account_page') }}">{{ 'navi.account' | trans }}</a>
                    </div>
{#                    <div class="currency">#}
{#                        <a href="#">RSD</a>#}
{#                        <ul class="menu-right-dropdown">#}
{#                            <li><a href="#">EUR</a></li>#}
{#                        </ul>#}
{#                    </div>#}
                    <div class="language">
                        {% if locale == 'en' %}
                            <a href="{{ locale != 'en' ? url_locale(routeName, routeParams, 'rs', 'en') : '#' }}">{{ 'english' | trans }}</a>
                        {% else %}
                        <a href="{{ locale != 'rs' ? url_locale(routeName, routeParams, 'en', 'rs') : '#' }}">{{ 'serbian' | trans }}</a>
                        {% endif %}
                        <ul id="locale-dropdown" class="menu-right-dropdown">
                            <li>
                                {% if locale == 'en' %}
                                    <a href="{{ locale != 'rs' ? url_locale(routeName, routeParams, 'en', 'rs') : '#' }}">{{ 'serbian' | trans }}</a>
                                {% else %}
                                    <a href="{{ locale != 'en' ? url_locale(routeName, routeParams, 'rs', 'en') : '#' }}">{{ 'english' | trans }}</a>
                                {% endif %}
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- mobile-menu-start -->
<div class="mobile-menu-area visible-xs visible-sm">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="mobile_menu">
                    <nav id="mobile_menu_active">
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.about_us' | trans }}</a>
                                <ul>
                                    <li><a href="{{ path('site.loyalty') }}">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="#">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <ul>
                                    {% for main in categories %}
                                        <li><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ main.slug }) }}">{{ main.title }}</a>
                                            {% if main.children is defined %}
                                                <ul>
                                                    {% for child in main.children %}
                                                        <li><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ child.slug }) }}">{{ child.title }}</a>
                                                            {% if child.children is defined %}
                                                                {{ childNavList.mobileChildNav(child.children) }}
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li><a href="{{ path('site.blog_list_page') }}">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page') }}">{{ 'navi.locations' | trans }}</a></li>
                            <li><a href="{{ path('site.ask_us') }}">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.contact' | trans }}</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- mobile-menu-end -->