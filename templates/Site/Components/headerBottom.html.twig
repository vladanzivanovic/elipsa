    {% import 'Site/Macros/navigation.html.twig' as childNavList %}
    {% set menuBanners = menu_banners(countryDefaultLocale) %}
    {% set seasonBanner = season_banner(locale) %}
<div class="menu-area hidden-sm hidden-xs">
    <div class="container">
        <div class="row position-relative">
            <div class="col-md-10 position-unset">
                <div class="menu">
                    <nav>
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.about_us.slug[locale]}) }}">{{ 'navi.about_us' | trans }}</a>
                                <ul class="menu-dropdown">
                                    <li><a href="{{ path('site.loyalty') }}">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="{{ path('site.catalog_page', {'_locale': locale}) }}">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <div class="mega-menu-area">
                                    <div class="row menu-row">
                                        <div class="left-side">
                                            <div class="mega-menu-part">
                                                <div class="mega-menu-content">
                                                    {% for mainCategory in navigationMenu %}
                                                        <a class="mega-menu-title" href="{{ path('site.shop_page', {('categories' | trans): mainCategory.slug }) }}">{{ mainCategory.title }}</a>
                                                        {% if mainCategory.children is defined %}
                                                            <ul class="sub-menu">
                                                                {% for child in mainCategory.children %}
                                                                    <li><a href="{{ path('site.shop_page', {('categories' | trans): child.slug }) }}">{{ child.title }}</a></li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                                <div class="mega-menu-img">
                                                    {% if menuBanners[0] is defined %}
                                                        <a href="{{ menuBanners[0].translations[locale].button_link }}">
                                                            <img src="{{ menuBanners[0].media.images.desktop.file }}" alt="{{ default_alt_tag }}">
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="mega-menu-part">
                                                <div class="mega-menu-content">
                                                    {% for tag in navigationTagsCollection %}
                                                        <a class="mega-menu-title" href="{{ path('site.shop_page', {('filter.collections' | trans): tag.translations[locale].slug }) }}">{{ tag.translations[locale].title }}</a>
                                                    {% endfor %}
                                                </div>
                                                <div class="mega-menu-img">
                                                    {% if menuBanners[1] is defined %}
                                                        <a href="{{ menuBanners[1].translations[locale].button_link }}">
                                                            <img src="{{ menuBanners[1].media.images.desktop.file }}" alt="{{ default_alt_tag }}">
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li><a href="{{ path('site.trendy_page') }}">{{ 'navi.seasons' | trans }}</a>
                                <div class="menu-dropdown with-img">
                                    <ul>
                                        {% for tag in navigationTagsSeasson %}
                                            <li><a href="{{ path('site.trendy_page', {('filter.seasons' | trans): tag.translations[locale].slug }) }}">{{ tag.translations[locale].title }}</a></li>
                                        {% endfor %}
                                    </ul>
                                    {% if seasonBanner is not null %}
                                        <a href="{{ seasonBanner.translations[locale].button_link }}">
                                            <img src="{{ seasonBanner.media.images.desktop.file }}" alt="{{ default_alt_tag }}">
                                        </a>
                                    {% endif %}
                                </div>
                            </li>
                            <li><a href="{{ path('site.blog_list_page') }}">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page') }}">{{ 'navi.locations' | trans }}</a></li>
                            <li><a href="{{ path('site.contact_page', {'_locale': locale}) }}">{{ 'navi.contact' | trans }}</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
            {% if false == is_mobile() and false == is_tablet() %}
                <div class="col-md-2">
                    <button class="search-opener hvr-bs pull-right"><i class="fa fa-search"></i></button>
                </div>
                {{ include('Site/Components/search.html.twig') }}
            {% endif %}
        </div>
    </div>
</div>
<!-- mobile-menu-start -->
<div class="mobile-menu-area visible-xs visible-sm">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="mobile_menu">
                    <nav id="mobile_menu_active">
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.about_us.slug[locale]}) }}">{{ 'navi.about_us' | trans }}</a>
                                <ul>
                                    <li><a href="{{ path('site.loyalty') }}">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="{{ path('site.catalog_page', {'_locale': locale}) }}">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <ul>
                                    {% for mainCategory in navigationMenu %}
                                        <li><a href="{{ path('site.shop_page', {('categories' | trans): mainCategory.slug }) }}">{{ mainCategory.title }}</a>
                                            {% if main.children is defined %}
                                                <ul>
                                                    {% for child in main.children %}
                                                        <li><a href="{{ path('site.shop_page', {('categories' | trans): child.slug }) }}">{{ child.title }}</a>
                                                            {% if child.children is defined %}
                                                                {{ childNavList.mobileChildNav(child.children) }}
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                    {% for tag in navigationTagsCollection %}
                                        <li>
                                            <a href="{{ path('site.shop_page', {('filter.collections' | trans): tag.translations[locale].slug }) }}">{{ tag.translations[locale].title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li><a href="{{ path('site.trendy_page') }}">{{ 'navi.seasons' | trans }}</a>
                                <ul>
                                    {% for tag in navigationTagsSeasson %}
                                        <li><a class="mega-menu-title" href="{{ path('site.trendy_page', {('filter.seasons' | trans): tag.translations[locale].slug }) }}">{{ tag.translations[locale].title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li><a href="{{ path('site.blog_list_page') }}">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page') }}">{{ 'navi.locations' | trans }}</a></li>
                            <li><a href="{{ path('site.contact_page', {'_locale': locale}) }}">{{ 'navi.contact' | trans }}</a></li>
                        </ul>

                    </nav>
                    {% if is_mobile() %}
                        {{ include('Site/Components/search.html.twig') }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<!-- mobile-menu-end -->
    {% set sliderTexts = slider_text(locale, constant('App\\Entity\\SliderText::POSITION_HEADER'), countryDefaultLocale) %}

    {% if sliderTexts | length > 0 %}
        <div class="slider-text-area">
            <div class="container">
                <div class="featured-items">
                    <div>
                        <div class="featured-all">
                            <div class="fi-row">
                                <div class="row">
                                    <div id="slider_text_carousel" class="feature-pro-carousel owl-carousel">
                                        {% for sliderText in sliderTexts %}
                                            <a href="{{ sliderText.link }}">{{ sliderText.title }}</a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
