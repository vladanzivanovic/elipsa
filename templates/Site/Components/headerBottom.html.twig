{% import 'Site/Macros/navigation.html.twig' as childNavList %}
<div class="menu-area hidden-sm hidden-xs">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="menu">
                    <nav>
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.about_us' | trans }}</a>
                                <ul class="menu-dropdown">
                                    <li><a href="02_Home Page.html">{{ 'navi.locations' | trans }}</a></li>
                                    <li><a href="02_Home Page.html">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="#">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <div class="mega-menu-area">
                                    <div class="row">
                                        {% for main in categories %}
                                            <div class="col-md-4">
                                                <div class="mega-menu-part">
                                                    <div class="mega-menu-content">
                                                        <a class="mega-menu-title" href="#">{{ main['title'] }}</a>
                                                        {% if main['children'] is defined %}
                                                            <ul>
                                                                {% for child in main['children'] %}
                                                                    <li class="sub-menu-holder"><a href="#">{{ child['title'] }}</a>
                                                                        {% if child['children'] is defined %}
                                                                           {{ childNavList.childNav(child['children']) }}
                                                                        {% endif %}
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </li>
                            <li><a href="#">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.contact' | trans }}</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="col-md-4">
                <div class="menu-area-right">
                    <div class="my-account">
                        <a href="#">{{ 'navi.account' | trans }}</a>
                        <ul class="menu-right-dropdown">
                            <li><a href="#">Your Account</a></li>
                            <li><a href="#">His Account</a></li>
                            <li><a href="#">Her Account</a></li>
                        </ul>
                    </div>
{#                    <div class="currency">#}
{#                        <a href="#">RSD</a>#}
{#                        <ul class="menu-right-dropdown">#}
{#                            <li><a href="#">EUR</a></li>#}
{#                        </ul>#}
{#                    </div>#}
                    <div class="language">
                        <a href="#"><img src="img/flag/english.png" alt="">Srpski</a>
                        <ul class="menu-right-dropdown">
                            <li>
                                <a href="#"><img src="img/flag/english.png" alt="">Engleski</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- mobile-menu-start -->
<div class="mobile-menu-area visible-xs visible-sm">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="mobile_menu">
                    <nav id="mobile_menu_active">
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.about_us' | trans }}</a>
                                <ul>
                                    <li><a href="02_Home Page.html">{{ 'navi.locations' | trans }}</a></li>
                                    <li><a href="02_Home Page.html">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="#">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="list-page.html">{{ 'navi.shop' | trans }}</a>
                                <ul>
                                    {% for main in categories %}
                                        <li><a href="04-Shop-Grid-Left-Sidebar.html">{{ main['title'] }}</a>
                                            {% if main['children'] is defined %}
                                                <ul>
                                                    {% for child in main['children'] %}
                                                        <li><a href="05-Shop-Grid-Right-Sidebar.html">{{ child['title'] }}</a>
                                                            {% if child['children'] is defined %}
                                                                {{ childNavList.mobileChildNav(child['children']) }}
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li><a href="#">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="#">{{ 'navi.contact' | trans }}</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- mobile-menu-end -->