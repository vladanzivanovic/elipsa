    {% import 'Site/Macros/navigation.html.twig' as childNavList %}
<div class="menu-area hidden-sm hidden-xs">
    <div class="container">
        <div class="row position-relative">
            <div class="col-md-8">
                <div class="menu">
                    <nav>
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="{{ path('site.about_us_page', {'_locale': locale}) }}">{{ 'navi.about_us' | trans }}</a>
                                <ul class="menu-dropdown">
                                    <li><a href="{{ path('site.loyalty') }}">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="{{ path('site.catalog_page', {'_locale': locale}) }}">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <div class="mega-menu-area">
                                    {% for categories in navigationMenu|batch(2) %}
                                        <div class="col-md-3">
                                            <div class="row">
                                                {% for main in categories %}
                                                    <div class="col-md-12">
                                                        <div class="mega-menu-part">
                                                            <div class="mega-menu-content">
                                                                <a class="mega-menu-title" href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ main.slug }) }}">{{ main.title }}</a>
                                                                {% if main.children is defined %}
                                                                    <ul>
                                                                        {% for child in main.children %}
                                                                            <li class="sub-menu-holder"><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ child.slug }) }}">{{ child.title }}</a>
                                                                                {% if child.children is defined %}
                                                                                   {{ childNavList.childNav(child.children) }}
                                                                                {% endif %}
                                                                            </li>
                                                                        {% endfor %}
                                                                    </ul>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </li>
                            <li><a href="{{ path('site.trendy_page') }}">{{ 'navi.trends' | trans }}</a>
                                <div class="mega-menu-area trendy">
                                    <div class="row">
                                        {% for tag in navigationTags %}
                                            <div class="col-md-3">
                                                <div class="mega-menu-part">
                                                    <div class="mega-menu-content">
                                                        <a class="mega-menu-title" href="{{ path('site.trendy_page', {'searchData': 'tags' | trans ~ '/' ~ tag.slug }) }}">{{ tag.label }}</a>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </li>
                            <li><a href="{{ path('site.blog_list_page') }}">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page') }}">{{ 'navi.locations' | trans }}</a></li>
                            <li><a href="{{ path('site.ask_us') }}">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="{{ path('site.contact_page', {'_locale': locale}) }}">{{ 'navi.contact' | trans }}</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
            {% if false == is_mobile() and false == is_tablet() %}
                <div class="col-md-4">
                    <button class="search-opener hvr-bs pull-right"><i class="fa fa-search"></i></button>
                </div>
                {{ include('Site/Components/search.html.twig') }}
            {% endif %}
        </div>
    </div>
</div>
<!-- mobile-menu-start -->
<div class="mobile-menu-area visible-xs visible-sm">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="mobile_menu">
                    <nav id="mobile_menu_active">
                        <ul class="menu-list">
                            <li><a href="{{ path('site.home_page') }}">{{ 'navi.home' | trans }}</a></li>
                            <li><a href="{{ path('site.about_us_page', {'_locale': locale}) }}">{{ 'navi.about_us' | trans }}</a>
                                <ul>
                                    <li><a href="{{ path('site.loyalty') }}">{{ 'navi.loyalty' | trans }}</a></li>
                                </ul>
                            </li>
                            <li><a href="{{ path('site.catalog_page', {'_locale': locale}) }}">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page') }}">{{ 'navi.shop' | trans }}</a>
                                <ul>
                                    {% for main in navigationMenu %}
                                        <li><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ main.slug }) }}">{{ main.title }}</a>
                                            {% if main.children is defined %}
                                                <ul>
                                                    {% for child in main.children %}
                                                        <li><a href="{{ path('site.shop_page', {'searchData': 'categories' | trans ~ '/' ~ child.slug }) }}">{{ child.title }}</a>
                                                            {% if child.children is defined %}
                                                                {{ childNavList.mobileChildNav(child.children) }}
                                                            {% endif %}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li><a href="{{ path('site.trendy_page') }}">{{ 'navi.trends' | trans }}</a>
                                <ul>
                                    {% for tag in navigationTags %}
                                        <li><a class="mega-menu-title" href="{{ path('site.trendy_page', {'searchData': 'tags' | trans ~ '/' ~ tag.slug }) }}">{{ tag.label }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li><a href="{{ path('site.blog_list_page') }}">{{ 'navi.blog' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page') }}">{{ 'navi.locations' | trans }}</a></li>
                            <li><a href="{{ path('site.ask_us') }}">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="{{ path('site.contact_page', {'_locale': locale}) }}">{{ 'navi.contact' | trans }}</a></li>
                        </ul>

                    </nav>
                    {% if is_mobile() %}
                        {{ include('Site/Components/search.html.twig') }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<!-- mobile-menu-end -->
    {% set sliderTexts = slider_text(locale) %}

    {% if sliderTexts | length > 0 %}
        <div class="slider-text-area">
            <div class="container">
                <div class="featured-items">
                    <div>
                        <div class="featured-all">
                            <div class="fi-row">
                                <div class="row">
                                    <div id="slider_text_carousel" class="feature-pro-carousel owl-carousel">
                                        {% for sliderText in sliderTexts %}
                                            <a href="{{ sliderText.link }}">{{ sliderText.description }}</a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}