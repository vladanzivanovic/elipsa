{% import 'Site/Macros/Inputs/input.html.twig' as inputs %}

<div class="header-top-right">
    <div class="login-or-register {{ is_mobile() ? 'col-xs-7 row' : '' }}">
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <a href="{{ path('site.logout') }}" id="logout"><span class="d-inline-block letter-capitalize">{{ 'logout.text' | trans }}</span></a>
        {% else %}
            <span id="login_register"><span class="d-inline-block letter-capitalize">{{ 'login.text' | trans }}</span> / <span class="d-inline-block letter-capitalize">{{ 'registration.text' | trans }}</span></span>
            <div class="login-register-content" id="login_register_content">
                <div class="lrc-login">
                    <h4 class="lrc-title letter-capitalize">{{ 'login.text' | trans }}</h4>
                    <div class="lrc-login-form">
                        <form id="login-form" enctype="multipart/form-data">
                            {{ inputs.input('_csrf_token_login', csrf_token('authenticate'), '_csrf_token', '', 'hidden') }}

                            <div class="account-name">
                                <i class="fa fa-user"></i>
                                {{ inputs.input('login_email', '', 'username', 'Email', 'email', 'letter-capitalize') }}
                            </div>
                            <div class="password">
                                <i class="fa fa-lock"></i>
                                {{ inputs.input('login_password', '', 'password', 'Password' | trans, 'password') }}

                            </div>
                            <div class="remember-help">
                                {{ inputs.input('login_remember_me', 1, '_remember_me', '', 'checkbox') }} {{ 'login.remember_me' | trans }}
                            </div>
                            <div class="lrc-submit">
                                <input id="login-btn" class="hvr-bs" type="button" value="{{ 'login.btn' | trans }}">
                            </div>
                        </form>
                    </div>
                </div>
                <div id="reset_password" class="remember-help">
                    <a href="#" id="reset_password_btn" class="letter-capitalize">{{ 'reset_password.text' | trans }}</a>
                </div>
                <div id="reset_password_form_wrapper" class="lrc-login" style="display: none">
                    <h4 class="lrc-title letter-capitalize">{{ 'reset_password.label' | trans }}</h4>
                    <div class="lrc-login-form">
                        <form id="reset_form" enctype="multipart/form-data">
                            {{ inputs.input('_csrf_token_reset_password', csrf_token('reset_password'), '_csrf_token', '', 'hidden') }}
                            <div class="account-name">
                                <i class="fa fa-user"></i>
                                {{ inputs.input('reset_email', '', 'reset_email', 'Email', 'email', 'letter-capitalize') }}
                            </div>
                            <div class="lrc-submit">
                                <input id="reset_btn" class="hvr-bs" type="button" value="{{ 'submit' | trans }}">
                            </div>
                        </form>
                    </div>
                </div>
                <div id="login_register_show" class="remember-help" style="display: none">
                    <a href="#" id="login_register_show_btn"><span class="d-inline-block letter-capitalize">{{ 'login.text' | trans }}</span> / <span class="d-inline-block letter-capitalize">{{ 'registration.text' | trans }}</span></a>
                </div>
                <div class="lrc-register">
                    <h4 class="lrc-title letter-capitalize">{{ 'registration.text' | trans }}</h4>
                    <div class="lrc-register-form">
                        <form id="registration-form" enctype="multipart/form-data">
                            {{ inputs.input('_csrf_token_registration', csrf_token('user_registration'), '_csrf_token', '', 'hidden') }}
                            {{ inputs.input('registration_first_name', '', 'registration_first_name', 'First_name' | trans, 'text', 'letter-capitalize') }}
                            {{ inputs.input('registration_last_name', '', 'registration_last_name', 'Last_name' | trans, 'text') }}
                            {{ inputs.input('registration_email', '', 'registration_email', 'Email', 'email') }}
                            {{ inputs.input('registration_password', '', 'registration_password', 'Password' | trans, 'password') }}
                            {{ inputs.input('registration_re_password', '', 'registration_re_password', 'Re_password' | trans, 'password') }}
                            <div class="lrc-register-btn">
                                <input id="registration-btn" class="hvr-bs" type="button" value="{{ 'registration.btn' | trans }}">
                            </div>
                        </form>
                    </div>
{#                    <div class="or-register-to">#}
{#                        <span class="letter-capitalize">{{ 'registration.via' | trans }}</span>#}
{#                        <ul>#}
{#                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>#}
{#                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>#}
{#                            <li><a href="#"><i class="fa fa-instagram"></i></a></li>#}
{#                            <li><a href="#"><i class="fa fa-google"></i></a></li>#}
{#                        </ul>#}
{#                    </div>#}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="top-cart {{ is_mobile() ? 'col-xs-5 row' : '' }}">
        <span id="top_cart" tabindex="3" class="letter-capitalize">
            <i class="fa fa-shopping-basket"></i>
            <span class="letter-capitalize d-inline-block">{{ 'cart.name' | trans }}</span>
            <span class="cart-number">
                (<span class="cart-length">0</span>)
            </span>
        </span>
        <div class="my-cart" id="my_cart">
            <div class="cart-wrapper hide">
                <div class="my-cart-products"></div>
                <div class="my-cart-total-cost">
                    <span class="letter-capitalize">{{ 'cart.total_products' | trans }}</span>
                    <span class="cost"><span class="cost__number"></span></span>
                </div>
                <div class="viewcart-checkout">
                    <a class="viewcart letter-capitalize" href="{{ path('site.cart_page') }}">{{ 'cart.view' | trans }}</a>
                    <a class="checkout letter-capitalize" href="{{ path('site.checkout_page') }}">{{ 'cart.checkout' | trans }}</a>
                </div>
            </div>
            <div class="empty-cart">
                <p>{{ 'cart.empty' | trans }}</p>
            </div>
        </div>
    </div>
</div>
