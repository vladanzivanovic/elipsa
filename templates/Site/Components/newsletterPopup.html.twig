{% set newsLetterBanner = banner(3, 'news_letter_banner', locale) %}
{% set bannerNewsLink = "background: rgba(0, 0, 0, 0) url("~ newsLetterBanner.image_link ~") no-repeat scroll left top / cover" %}

<!-- newsletter-popup-start -->
<div id="wd1_nlpopup_overlay"></div>
<form id="wd1_nlpopup" data-expires="30" data-delay="10" style="{{ bannerNewsLink }}">
    <a href="#closepopup" id="wd1_nlpopup_close">x</a>
    <h2>newsletter</h2>
    <p class="text-uppercase">{{ 'newsletter.text' | trans }}</p>
    <div class="popup-subscribe-box">
        <input type="email" name="email" value="">
        <input id="news_letter_btn" type="button" value="{{ 'submit' | trans }}">
    </div>
    <div class="pupup-dont-show">
        <input type="checkbox">
        <span class="d-inline-block letter-capitalize">{{ 'newsletter.notShowBtn' | trans }}</span>
    </div>
</form>
<!-- newsletter-popup-end -->