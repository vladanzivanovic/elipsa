{% set sliderTexts = slider_text(locale, constant('App\\Entity\\SliderText::POSITION_FOOTER')) %}

<div class="footer-top-area">
    <div class="container">
        <div class="footer-top">
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="footer-desc banner-text">
                        {% for sliderText in sliderTexts %}
                            <a href="{{ sliderText.link }}">
                                <span class="banner-text-title">{{ sliderText.title }}</span>
                                <span class="banner-text-description">{{ sliderText.description }}</span>
                            </a>
                        {% endfor %}

                        <div class="footer-newsletter-area">
                            <div class="container">
                                <div class="row">
                                    <div class="col-md-5 col-sm-8 col-xs-12">
                                        <div class="h3-newsletter-left">
                                            <h3 class="h3-nl-title">newsletter</h3>
                                            <p class="h3-nl-text text-uppercase">{{ 'newsletter.text' | trans }}</p>
                                        </div>
                                    </div>
                                    <div class="col-md-7 col-sm-4 col-xs-12">
                                        <div class="h3-newsletter-form">
                                            {% import 'Site/Macros/Inputs/input.html.twig' as inputs %}

                                            <form id="news_letter" class="news-letter-form regular-form">
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        {{ inputs.input('newsletter_email', '', 'newsletter_email', 'Email *', 'email') }}
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-xs-12 col-md-4 m-bt-2-xs m-bt-2-sm">
                                                        {% set genderOptions = [
                                                            {'title': 'male' | trans , 'value': 'male' },
                                                            {'title': 'female' | trans , 'value': 'female' },
                                                        ]
                                                        %}
                                                        {{ inputs.selectbox('gender', 'newsletter_gender', '', genderOptions, '', '', false, 'choose_gender') }}
                                                    </div>
                                                    <div class="col-xs-12 col-md-4">
                                                        {{ inputs.selectbox('language', 'newsletter_language', '', languageOptionsByCountry, '', '', false, 'choose_language') }}
                                                    </div>
                                                    <div class="col-xs-12 col-md-4 m-t-2-xs m-t-2-sm">
                                                        <button class="news_letter_btn submit-btn full-width hvr-bs text-uppercase" type="button">{{ 'submit' | trans }}</button>
                                                    </div>
                                                </div>
{#                                                <div class="row news-letter-submit">#}
{#                                                    <div class="col-xs-12">#}
{#                                                        <button class="news_letter_btn submit-btn" type="button">{{ 'submit' | trans }}</button>#}
{#                                                    </div>#}
{#                                                </div>#}
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

{#                        <div class="logo-footer text-center">#}
{#                        <img src="{{ asset('build/site/images/logo/logo_bottom.png') }}" alt="{{ default_alt_tag }}">#}
{#                        </div>#}
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 col-xs-12">
                    <div class="footer-links">
                        <h4 class="footer-title">{{ 'navi.account' | trans }}</h4>
                        <ul class="clearfix account">
                            <li><a id="footer-login-btn" href="#">{{ 'login.text' | trans }}</a></li>
                            <li><a id="footer-registration-btn" href="#">{{ 'registration.text' | trans }}</a></li>
                            <li><a id="footer-order-list-btn" href="{{ path('site.account_page') }}#order-list">{{ 'navi.orders' | trans }}</a></li>
                            <li><a id="footer-wish-list-btn" href="{{ path('site.account_page') }}#wish-list">{{ 'my_account.wish_list' | trans }}</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 col-xs-12">
                    <div class="footer-links">
                        <h4 class="footer-title">{{ 'shopping' | trans }}</h4>
                        <ul class="clearfix">
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.use_conditions.slug[locale]}) }}">{{ 'navi.use_conditions' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.withdraw_policy.slug[locale]}) }}">{{ 'navi.withdraw_policy' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.complaint.slug[locale]}) }}">{{ 'navi.complaint' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.payment_methods.slug[locale]}) }}">{{ 'navi.payment_methods' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.delivery.slug[locale]}) }}">{{ 'navi.delivery' | trans }}</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 col-xs-12">
                    <div class="footer-links">
                        <h4 class="footer-title">{{ 'info' | trans }}</h4>
                        <ul class="clearfix">
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.free_delivery.slug[locale]}) }}">{{ 'navi.free_delivery' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.in_store_pickup.slug[locale]}) }}">{{ 'navi.in_store_pickup' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.product_rehearsal.slug[locale]}) }}">{{ 'navi.product_rehearsal' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.product_return_and_exchange.slug[locale]}) }}">{{ 'navi.product_return_and_exchange' | trans }}</a></li>
                            <li><a href="{{ path('site.company_text', {'_locale': locale, 'type': siteInfoText.refund.slug[locale]}) }}">{{ 'navi.refund' | trans }}</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 col-xs-12">
                    <div class="footer-desc">
                        <div class="footer-desc-contact">
                            <h4 class="footer-title">{{ 'title.contact_us' | trans }}</h4>
                            <ul>
                                <li>{{ siteSettings.settings.full_company_name.value }}</li>
                                <li>{{ siteSettings.settings.street.value }}</li>
                                <li>{{ 'company_identification_number' | trans }}: {{ siteSettings.settings.company_id.value }}</li>
                                <li>PIB: {{ siteSettings.settings.pib.value }}</li>
                                <li>{{ 'email' | trans }}: {{ siteSettings.settings.main_email.value }}</li>
                                {% for contact in siteSettings.office_contacts %}
                                    <li>{{ contact.translations[locale].title }}: {{ contact.telephone }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
