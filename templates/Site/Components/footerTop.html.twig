{% set siteSettings = settings() %}
{% set sliderTexts = slider_text(locale, constant('App\\Entity\\SliderText::POSITION_FOOTER')) %}

<div class="footer-top-area">
    <div class="container">
        <div class="footer-top">
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="footer-desc banner-text">
                        {% for sliderText in sliderTexts %}
                            <a href="{{ sliderText.link }}">
                                <span class="banner-text-title">{{ sliderText.title }}</span>
                                <span class="banner-text-description">{{ sliderText.description }}</span>
                            </a>
                        {% endfor %}


{#                        <div class="logo-footer text-center">#}
{#                        <img src="{{ asset('build/site/images/logo/logo_bottom.png') }}" alt="{{ default_alt_tag }}">#}
{#                        </div>#}
                    </div>
                </div>
                <div class="col-md-2 col-sm-6 col-xs-12">
                    <div class="footer-desc">
                        <div class="footer-desc-contact">
                            <h4 class="footer-title">{{ 'title.contact_us' | trans }}</h4>
                            <ul class="clearfix">
                                <li><i class="fa fa-mobile"></i>{{ siteSettings.TELEPHONE }}</li>
                                <li><i class="fa fa-envelope-o"></i>{{ siteSettings.MAIN_EMAIL }}</li>
                                <li><i class="fa fa-map-marker"></i>{{ siteSettings.STREET }}, {{ siteSettings.ZIP_CODE }} {{ siteSettings.CITY }} {{ 'serbia' | trans }}</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-offset-1 col-md-2 col-sm-6 col-xs-12">
                    <div class="footer-links">
                        <h4 class="footer-title">{{ 'store' | trans }}</h4>
                        <ul class="clearfix">
                            <li><a href="{{ path('site.catalog_page', {'_locale': locale}) }}">{{ 'navi.catalogue' | trans }}</a></li>
                            <li><a href="{{ path('site.shop_page', {'_locale': locale}) }}">{{ 'navi.shop' | trans }}</a></li>
                            <li><a href="{{ path('site.trendy_page', {'_locale': locale}) }}">{{ 'navi.trends' | trans }}</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-2 col-sm-6 col-xs-12">
                    <div class="footer-links">
                        <h4 class="footer-title">Elipsa</h4>
                        <ul class="clearfix">
                            <li><a href="{{ path('site.about_us_page', {'_locale': locale}) }}">{{ 'navi.about_us' | trans }}</a></li>
                            <li><a href="{{ path('site.contact_page', {'_locale': locale}) }}">{{ 'navi.contact' | trans }}</a></li>
                            <li><a href="{{ path('site.ask_us', {'_locale': locale}) }}">{{ 'navi.ask_us' | trans }}</a></li>
                            <li><a href="{{ path('site.collaborator', {'_locale': locale}) }}">{{ 'navi.collaborators' | trans }}</a></li>

                            <li><a href="{{ path('site.jobs_list_page', {'_locale': locale}) }}">{{ 'navi.career' | trans }}</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-2 col-sm-6 col-xs-12">
                    <div class="footer-links">
                        <h4 class="footer-title">{{ 'info' | trans }}</h4>
                        <ul class="clearfix">
                            <li><a href="{{ path('site.policy_page', {'_locale': locale}) }}">{{ 'navi.policy_and_privacy' | trans }}</a></li>
                            <li><a href="{{ path('site.use_conditions', {'_locale': locale}) }}">{{ 'navi.use_conditions' | trans }}</a></li>
                            <li><a href="{{ path('site.cookie_policy', {'_locale': locale}) }}">{{ 'navi.cookie_policy' | trans }}</a></li>
                            <li><a href="{{ path('site.location_page', {'_locale': locale}) }}">{{ 'navi.locations' | trans }}</a></li>

                        </ul>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 col-xs-12">
                    <div class="popular-tag">
                        <h4 class="footer-title">newsletter</h4>
                        <form id="newsletter_form_footer">
                            {% import 'Site/Macros/Inputs/formWithLabels.html.twig' as form %}

                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="cfc-input-box">
                                        {{ form.input('email' | trans ~ ' *', 'newsletterEmail', '', 'newsletter_email', '', 'email', null, '', 'text-uppercase') }}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-xs-12 pull-right">
                                    <button id="newsletter_submit" class="submit hvr-bs" data-animation-type="bounce" data-animation-duration="1" style="animation-duration: 1s; visibility: visible;" type="button">{{ 'submit' | trans }}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="row">

            </div>
        </div>
    </div>
</div>