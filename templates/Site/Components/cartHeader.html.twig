<!-- shopping-head-area-start -->
{% set orderCompletePage = false %}
{% if routeName == 'site.checkout_completed_successful' %}
    {% set orderCompletePage = true %}
{% endif %}
<div class="shopping-head-area">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="shopping-head">
                    <div class="clerafix">
                        <a href="{{ path('site.cart_page') }}" class="sh-menu-item {{ true == orderCompletePage ? 'disabled': '' }} {{ routeName == 'site.cart_page' ? 'active': '' }}">
                            <p class="letter-capitalize">{{ 'cart.name' | trans }}</p>
                            <span>01</span>
                        </a>
                        <a href="{{ path('site.checkout_page') }}" class="sh-menu-item {{ true == orderCompletePage ? 'disabled': '' }} {{ routeName == 'site.checkout_page' ? 'active' : '' }}">
                            <p class="letter-capitalize">{{ 'cart.personal_data' | trans }}</p>
                            <span>02</span>
                        </a>
                        <div class="sh-menu-item {{ true == orderCompletePage ? 'active' : '' }}">
                            <p class="letter-capitalize">{{ 'cart.order_completed_successful' | trans }}</p>
                            <span>03</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- shopping-head-area-end -->
