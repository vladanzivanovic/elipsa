{% import 'Site/Macros/sideBar.html.twig' as childNavList %}

<div class="shop-sidebar-area {{ filterClass }}">
    <div class="sidebar-widget widget-categories">
        <h4 class="sidebar-title">{{ 'tags' | trans }}</h4>
        {% for tag in tags %}
            <div class="sidebar-box">
                <button class="sidebar-category-button category-btn {{ search.tags is defined and tag.slug in search.tags ? 'active' : '' }}" data-search-name="tags" data-search="{{ tag.slug }}">{{ tag.title }}</button>
            </div>
        {% endfor %}
    </div>
    <div class="sidebar-widget widget-shop-by">
        <h4 class="sidebar-title">{{ 'filters' | trans }}</h4>
        <div class="sidebar-box">
            <span class="sidebar-box-title">{{ 'price' | trans }}</span>
            <div class="priceslider">
                <p>
                    <input type="text" id="shop-amount" readonly>
                </p>
                <div id="shop-slider-range"></div>
            </div>
        </div>
{#        <div class="sidebar-box">#}
