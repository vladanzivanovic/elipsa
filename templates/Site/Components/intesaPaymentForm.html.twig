{% set locale = app.request.locale %}

<form id="intesa_form" method="post" action="{{ intesa_gateway }}">
    <input type="hidden" name="currency" value="941" />
    <input type="hidden" name="trantype" value="Auth" />
    <input type="hidden" name="okUrl" value="{{ absolute_url(path('site.checkout_completed_successful', {'_locale': locale})) }}"/>
    <input type="hidden" name="failUrl" value="{{ absolute_url(path('site.checkout_failed', {'_locale': locale})) }}" />
    <input type="hidden" name="amount" value="6000.00" />
    <input type="hidden" name="oid" value="" />
    <input type="hidden" name="clientid" value="{{ intesa_merchant_id }}"/>
    <input type="hidden" name="storetype" value="3d_pay_hosting" />
    <input type="hidden" name="lang" value="{{ locale }}" />
    <input type="hidden" name="hashAlgorithm" value="ver2" />
    <input type="hidden" name="rnd" value="N2855INH5EM5T7VYL9LA" />
    <input type="hidden" name="encoding" value="utf-8" />
    <input type="hidden" name="hash" value="" />
    <input type='hidden' name='shopurl' value='{{ absolute_url(path('site.checkout_failed', {'_locale': locale})) }}' />

