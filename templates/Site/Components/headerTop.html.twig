<div class="header-top">
    <div class="container">
        <div class="row">
            <div class="col-md-5 col-sm-4 col-xs-12">
                <div class="header-top-left">
                    <div class="logo">
                        <a href="/"><img src="logo/logo-black.jpg" alt=""></a>
                    </div>
                </div>
            </div>
            <div class="col-md-7 col-sm-8 col-xs-12">
                <div class="header-top-right">
                    <div class="htr-search">
                        <form action="#">
                            <div class="htr-search-content">
                                <input type="text" placeholder="Pretraži...">
                                <button><i class="fa fa-search"></i></button>
                            </div>
                        </form>
                    </div>
                    <div class="login-or-register">
                        <span id="login_register">Prijava / Registracija</span>
                        <div class="login-register-content" id="login_register_content">
                            <div class="lrc-login">
                                <h4 class="lrc-title">Prijava</h4>
                                <div class="lrc-login-form">
                                    <form action="#">
                                        <div class="account-name">
                                            <i class="fa fa-user"></i>
                                            <input type="text" placeholder="Email">
                                        </div>
                                        <div class="password">
                                            <i class="fa fa-lock"></i>
                                            <input type="password" placeholder="Lozinka">
                                        </div>
                                        <div class="remember-help">
                                            <input type="checkbox">
                                            <label>zapamti me</label>
                                        </div>
                                        <div class="lrc-submit">
                                            <input class="hvr-bs" type="submit" value="Prijavi se">
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div class="lrc-register">
                                <h4 class="lrc-title">Registracija</h4>
                                <div class="lrc-register-form">
                                    <form action="#">
                                        <input type="text" placeholder="Email">
                                        <input type="password" placeholder="Lozinka">
                                        <div class="lrc-register-btn">
                                            <input class="hvr-bs" type="submit" value="Registruj se">
                                        </div>
                                    </form>
                                </div>
                                <div class="or-register-to">
                                    <span>ili registruj se putem</span>
                                    <ul>
                                        <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                        <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                        <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                                        <li><a href="#"><i class="fa fa-google"></i></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="top-cart">
                        <span id="top_cart"><i class="fa fa-shopping-basket"></i>Korpa <span class="cart-number">(3)</span></span>
                        <div class="my-cart" id="my_cart">
                            <div class="my-cart-products">
                                <div class="single-mcp clearfix">
                                    <div class="single-mcp-img">
                                        <img src="cart/azra_cart.jpg" alt="">
                                    </div>
                                    <div class="single-mcp-content">
                                        <a class="mcp-product-name" href="#">Azra</a>
                                        <span class="mcp-pro-quantity">1 x <span class="mcp-pro-price">$50</span></span>
                                    </div>
                                    <a href="#" class="mcp-pro-delete"><i class="fa fa-times"></i></a>
                                </div>
                                <div class="single-mcp clearfix">
                                    <div class="single-mcp-img">
                                        <img src="cart/elen_cart.jpg" alt="">
                                    </div>
                                    <div class="single-mcp-content">
                                        <a class="mcp-product-name" href="#">Elen</a>
                                        <span class="mcp-pro-quantity">1 x <span class="mcp-pro-price">$50</span></span>
                                    </div>
                                    <a href="#" class="mcp-pro-delete"><i class="fa fa-times"></i></a>
                                </div>
                                <div class="single-mcp clearfix">
                                    <div class="single-mcp-img">
                                        <img src="cart/lula_cart.jpg" alt="">
                                    </div>
                                    <div class="single-mcp-content">
                                        <a class="mcp-product-name" href="#">Lula</a>
                                        <span class="mcp-pro-quantity">1 x <span class="mcp-pro-price">$50</span></span>
                                    </div>
                                    <a href="#" class="mcp-pro-delete"><i class="fa fa-times"></i></a>
                                </div>
                            </div>
                            <div class="my-cart-total-cost">
                                <span>Total cost</span>
                                <span class="cost">$500</span>
                            </div>
                            <div class="viewcart-checkout">
                                <a class="viewcart" href="#">View cart</a>
                                <a class="checkout" href="#">Check out</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>