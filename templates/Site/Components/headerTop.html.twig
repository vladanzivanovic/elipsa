<div class="header-top">
    <div class="container">
        {% if is_mobile() %}
            <div class="row mobile-lang-bar">
                <div class="my-account col-xs-4 text-center row">
                    <a href="{{ path('site.account_page') }}">{{ 'navi.account' | trans }}</a>
                </div>
                <div class="col-xs-7 row">
                    <div class="logo">
                        <a href="{{ path('site.home_page') }}"><img src="{{ asset('build/site/images/logo/logo_header.png') }}" alt="{{ default_alt_tag }}"></a>
                    </div>
                </div>
                <div class="language col-xs-3 text-center row">
                    {% for language in languages %}
                        {% if locale == language.code %}
                            <a href="#">{{ language.name | trans }}</a>
                        {% endif %}
                    {% endfor %}
                    <ul id="locale-dropdown" class="menu-right-dropdown">
                        {% for localeCode, language in transUrls %}
                            {% if locale != localeCode %}
                                <li>
                                    <a id="locale_{{ language.code }}" data-locale-code="{{ language.code }}" href="{{ language.url }}">{{ language.name | trans }}</a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>


