{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje / Izmena tagova{% endblock %}

{% set routeSubName = routeName() == 'admin.add_blog_tag_page' or routeName() == 'admin.edit_blog_tag_page' ? 'blog' : 'product' %}

{% block content %}
    {% set IS_EDIT = routeName() == 'admin.edit_' ~ routeSubName ~ '_tag_page' %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje - izmena tagova' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}


    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Dodavanje - izmena tagova</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        {% for locale, lang in app_params('languages') %}
            <div class="row grid-margin">
                <div class="col-md-12 stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.name }}</h6>
                            <div class="row">
                                <div class="col-sm-6 col-md-4">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? tag[locale].title : '', locale~'[title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        {% if routeSubName == 'product' %}
        <div class="row grid-margin">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Dodatne informacije</h6>
                        <div class="row">
                            <div class="col-sm-6 col-md-4">
                                <div class="form-group">
                                    {{ form.select('Tip taga', 'product_type', 'product_type', IS_EDIT ? tag.product_type : '', options, '', 'w-100') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </form>
    {{ form.button('tag_submit', 'btn btn-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ app.request.attributes.has('slug') ? 1 : 0 }};
        const SLUG = '{{ app.request.attributes.get('slug') }}';
        const ROUTE_SUB_NAME = '{{ routeSubName }}';
    </script>
{% endblock %}
