{% extends 'Admin/base.html.twig' %}

{% set type = routeName() == 'admin.add_blog_tag_page' or routeName() == 'admin.edit_blog_tag_page' ? 'blog' : 'product' %}
{% set typeTitle = type == 'blog' ? 'blog' : 'proizvod' %}
{% set IS_EDIT = routeName() == 'admin.edit_' ~ type ~ '_tag_page' %}

{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' taga' %}
{% set routePath = 'admin.' ~ type ~ '_tags' %}
{% set routeTitle = 'Tagovi' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">{{ title }}</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        {% for locale, lang in languages %}
            <div class="row grid-margin">
                <div class="col-md-12 stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.translation | trans }}</h6>
                            <div class="row">
                                <div class="col-sm-6 col-md-4">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? payload.translations[locale].title : '', 'translations['~locale~'][title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        {% if type == 'product' %}
            <div class="row grid-margin">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">Dodatne informacije</h6>
                            <div class="row">
                                <div class="col-sm-6 col-md-4">
                                    <div class="form-group">
                                        {{ form.select('Tip taga', 'product_type', 'product_type', IS_EDIT ? payload.product_type : '', options, '', 'w-100') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </form>
    {{ include('Admin/Components/formButtons.html.twig') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ app.request.attributes.has('slug') ? 1 : 0 }};
        const SLUG = '{{ app.request.attributes.get('slug') }}';
        const TAG_TYPE = '{{ type }}';
    </script>
{% endblock %}
