{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje/Izmena kontakt podataka{% endblock %}
{% block bodyClass %}office-contact-edit{% endblock %}
{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_office_contact_page' %}
{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje/Izmena kontakt informacija' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <form id="edit_form" enctype="multipart/form-data">
        {% for locale, lang in app_params('languages') %}
            <div class="row">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.name }}</h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? payload[locale]['title'] : '', locale~'[title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Opšte informacije</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Broj telefona', 'telephone', IS_EDIT ? payload['telephone'] : '', 'telephone') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <p>&nbsp;</p>
                                <div class="form-group form-check form-check-flat form-check-primary">
                                    {{ form.checkbox('Prikaži u footer', 'show_in_footer', 1, 'show_in_footer', 'form-check-label', 'form-check-input', IS_EDIT and true == payload['isShownInFooter'] ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
    </script>
{% endblock %}
