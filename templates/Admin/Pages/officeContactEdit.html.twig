{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_office_contact_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' kontakt podataka' %}
{% set routePath = 'admin.office_contacts' %}
{% set routeTitle = 'Kontakt podaci' %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}office-contact-edit{% endblock %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Odabir države</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Zemlja', 'country-select-box', 'available_countries[]', IS_EDIT ? payload.available_countries : '' , countries_options(), '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in languages %}
            <div class="row country_{{ locale }} hide-country">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.translation | trans }}</h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? payload.translations[locale]['title'] : '', 'translations['~locale~'][title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Opšte informacije</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Broj telefona', 'telephone', IS_EDIT ? payload['telephone'] : '', 'telephone') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-3">
                                <p>&nbsp;</p>
                                <div class="form-group form-check form-check-flat form-check-primary">
                                    {{ form.checkbox('Prikaži u footer', 'show_in_footer', 1, 'show_in_footer', 'form-check-label', 'form-check-input', IS_EDIT and true == payload['show_in_footer'] ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-3">
                                <p>&nbsp;</p>
                                <div class="form-group form-check form-check-flat form-check-primary">
                                    {{ form.checkbox('Prikaži u emailu', 'use_in_email', 1, 'use_in_email', 'form-check-label', 'form-check-input', IS_EDIT and true == payload['use_in_email'] ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ include('Admin/Components/formButtons.html.twig') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
    </script>
{% endblock %}
