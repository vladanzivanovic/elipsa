{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_coupon_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' promotivnih kupona' %}
{% set OPTION_TYPES = get_class_constants('App\\Entity\\PromotionOption') %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: 'admin.coupons', name: 'Promotivni kuponi'}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">{{ title }}</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 stretch-card">
            <div class="card">
                <div class="card-body">
                    <form id="edit_form" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-6 col-md-4">
                                <div class="form-group">
                                    {{ form.input('Promo kod', 'code', IS_EDIT ? payload.code : '', 'code') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6 col-md-4">
                                <div class="form-group">
                                    {{ form.datePicker('Važi od', 'valid_from', IS_EDIT ? payload.valid_from : '', 'valid_from') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6 col-md-4">
                                <div class="form-group">
                                    {{ form.datePicker('Važi do', 'valid_to', IS_EDIT ? payload.valid_to : '', 'valid_to') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6 col-md-4">
                                <div class="form-group">
                                    {{ form.input('Popust', 'discount', IS_EDIT ? payload.percentage : '', 'discount', '', 'number') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-md-12 grid-margin">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Opcije</h6>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Kategorije', 'categories', 'options['~OPTION_TYPES.OPTION_CATEGORIES~'][]', IS_EDIT and payload.options[OPTION_TYPES.OPTION_CATEGORIES] is defined ? payload.options[OPTION_TYPES.OPTION_CATEGORIES].configuration : '', options.categories, '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Tagovi', 'tags', 'options['~OPTION_TYPES.OPTION_TAGS~'][]', IS_EDIT and payload.options[OPTION_TYPES.OPTION_TAGS] is defined ? payload.options[OPTION_TYPES.OPTION_TAGS].configuration : '', options.tags, '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Proizvodi', 'products', 'options['~OPTION_TYPES.OPTION_PRODUCTS~'][]', '', [], '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div><!-- Row -->
                                        <div class="row">
                                            <div class="col-sm-3">
                                                <p>&nbsp;</p>
                                                <div class="form-check form-check-flat form-check-primary">
                                                    {{ form.checkbox('Primeni i na snižene proizvode', 'applicableAllProducts', 1, 'options['~OPTION_TYPES.OPTION_ALL_PRODUCTS~']', 'form-check-label', 'form-check-input', IS_EDIT and payload.options[OPTION_TYPES.OPTION_ALL_PRODUCTS] is defined and payload.options[OPTION_TYPES.OPTION_ALL_PRODUCTS].configuration[0] == true ? 'checked="checked"' : null ) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div><!-- Row -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    {{ form.button('submit_btn', 'btn btn-primary submit', 'Sačuvaj', 'button') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = {{ IS_EDIT ? app.request.attributes.get('id') : 0 }};
        const PRODUCTS = {{ IS_EDIT and payload.options[OPTION_TYPES.OPTION_PRODUCTS] is defined ? payload.options[OPTION_TYPES.OPTION_PRODUCTS].configuration | json_encode | raw : '[]' }};
    </script>
{% endblock %}
