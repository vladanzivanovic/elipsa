{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje/Izmena bloga{% endblock %}
{% block bodyClass %}blog-edit{% endblock %}
{% set isEdit = routeName() == 'admin.edit_blog_page' %}
{% block content %}


    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje - izmena bloga' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Blog</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Veličine glavne slika</h4>
                    <ul>
                        <li>1500 x 612</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Glavna slika</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'blog', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in app_params('languages') %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">{{ lang.name }}</h6>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    {{ form.input('Naziv *', 'title_'~locale, isEdit ? payload.translations[locale]['title'] : null , locale~'[title]', '', 'text', null, 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <div class="form-group">
                                        {{ form.textarea('Kratak opis *', 'short_description_'~locale, isEdit ? payload.translations[locale]['short_description'] : null, locale~'[short_description]', 3, '', 'form-control') }}
                                    </div>
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <div class="form-group">
                                        {{ form.textarea('Detaljan opis *', 'description_'~locale, isEdit ? payload.translations[locale]['description'] : null , locale~'[description]', 10, '', 'form-control') }}
                                    </div>
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Dodatne informacije</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Tagovi', 'tags', 'tags[]', isEdit ? payload.tags : '', options.tags, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ isEdit ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';

        {% if isEdit %}
            const IMAGES = JSON.parse('{{ payload.media.images|json_encode()|raw }}');
        {% endif %}
    </script>
{% endblock %}
