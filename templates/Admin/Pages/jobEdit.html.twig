{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = routeName() == 'admin.edit_job' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' radnog mesta' %}
{% set routePath = 'admin.sliders' %}
{% set routeTitle = 'Radna mesta' %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}job-edit{% endblock %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]} %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Radno mesto</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Veličine glavne slika</h4>
                    <ul>
                        <li>1060x1580</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Odabir države</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Zemlja', 'country-select-box', 'available_countries[]', IS_EDIT ? payload.available_countries : '' , countries_options(), '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Glavna slika</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'job', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in languages %}
            <div class="row country_{{ locale }} hide-country">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.translation | trans }}</h6>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        {{ form.input('Naziv *', 'title_'~locale, IS_EDIT ? payload.translations[locale].title : null , 'translations['~locale~'][title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <div class="form-group">
                                            {{ form.textarea('Detaljan opis *', 'description_'~locale, IS_EDIT ? payload.translations[locale].description : null , 'translations['~locale~'][description]', 10, '', 'form-control') }}
                                        </div>
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </form>
    {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ payload.media.images|json_encode()|raw }}');
        {% endif %}
    </script>
{% endblock %}
