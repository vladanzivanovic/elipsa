{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = 'admin.edit_promotion' in app.request.attributes.get('_route') %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' promocija' %}
{% set RULES = get_class_constants('App\\Entity\\PromotionOption', 'RULE') %}
{% set OPTIONS = get_class_constants('App\\Entity\\PromotionOption', 'OPTION') %}
{% set routePath = 'admin.promotions' %}
{% set routeTitle = 'Promocije' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}


    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: 'admin.promotions', name: 'Promocije'}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">{{ title }}</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 stretch-card">
            <div class="card">
                <div class="card-body">
                    <form id="edit_form" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-12 grid-margin">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Odabir države</h6>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Zemlja', 'country-select-box', 'available_countries[]', IS_EDIT ? payload.available_countries : '' , countries_options(), '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 grid-margin">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Osnovna podešavanja</h6>
                                        <div class="row">
                                            <div class="col-sm-6 col-md-4">
                                                <div class="form-group">
                                                    {{ form.select('Tip promocije', 'type', 'type', IS_EDIT ? payload.type : '', options.promotion_types, '', 'w-100') }}
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6 col-md-4">
                                                <div class="form-group">
                                                    {{ form.input('Promo kod', 'code', IS_EDIT ? payload.code : '', 'code') }}
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6 col-md-4">
                                                <div class="form-group">
                                                    {{ form.input('Popust', 'discount', IS_EDIT ? payload.percentage : '', 'discount', '', 'number') }}
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6 col-md-4">
                                                <div class="form-group">
                                                    {{ form.datePicker('Važi od', 'valid_from', IS_EDIT ? payload.valid_from.date ~' '~ payload.valid_from.time : '', 'valid_from') }}
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6 col-md-4">
                                                <div class="form-group">
                                                    {{ form.datePicker('Važi do', 'valid_to', IS_EDIT ? payload.valid_to.date ~' '~ payload.valid_to.time : '', 'valid_to') }}
                                                </div>
                                            </div><!-- Col -->
                                        </div><!-- Row -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 grid-margin">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Pravila</h6>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Proizvodi - 100', 'products', 'options['~RULES.RULE_PRODUCTS~'][]', '', [], '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Tagovi - 50', 'tags', 'options['~RULES.RULE_TAGS~'][]', IS_EDIT and payload.options[RULES.RULE_TAGS] is defined ? payload.options[RULES.RULE_TAGS].configuration : '', options.tags, '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label for="colors">Boje - 30</label>
                                                    <select id="colors" name="options[{{ RULES.RULE_COLORS }}][]" multiple="multiple">
                                                        {% for color in options.colors %}
                                                            {% set selected = IS_EDIT and payload.options[RULES.RULE_COLORS] is defined ? color.value in payload.options[RULES.RULE_COLORS].configuration : '' %}

                                                            <option value="{{ color.value }}" data-title="{{ color.title }}" data-hex="{{ color.hex }}" {{ selected ? 'selected="selected"' : '' }}>{{ color.title }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                            </div><!-- Col -->
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    {{ form.select('Kategorije - 10', 'categories', 'options['~RULES.RULE_CATEGORIES~'][]', IS_EDIT and payload.options[RULES.RULE_CATEGORIES] is defined ? payload.options[RULES.RULE_CATEGORIES].configuration : '', options.categories, '', 'w-100', true) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div><!-- Row -->
                                        <div class="row">
                                            <div class="col-sm-3">
                                                <p>&nbsp;</p>
                                                <div class="form-check form-check-flat form-check-primary">
                                                    {{ form.checkbox('Primeni i na snižene proizvode', 'applicableAllProducts', 1, 'options['~RULES.RULE_ALL_PRODUCTS~']', 'form-check-label', 'form-check-input', IS_EDIT and payload.options[RULES.RULE_ALL_PRODUCTS] is defined and payload.options[RULES.RULE_ALL_PRODUCTS].configuration[0] == true ? 'checked="checked"' : null ) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div><!-- Row -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 grid-margin">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Bar na početnoj stranici - podešavanje</h6>
                                        <div class="row">
                                            <div class="col-sm-3">
                                                <p>&nbsp;</p>
                                                <div class="form-check form-check-flat form-check-primary">
                                                    {{ form.checkbox('Prikaži bar na početnoj stranici', 'homePageBar', 1, 'options['~OPTIONS.OPTION_HOME_SCREEN_BAR~']', 'form-check-label', 'form-check-input', IS_EDIT and payload.options[OPTIONS.OPTION_HOME_SCREEN_BAR] is defined and payload.options[OPTIONS.OPTION_HOME_SCREEN_BAR].configuration[0] == true ? 'checked="checked"' : null ) }}
                                                </div>
                                            </div><!-- Col -->
                                        </div>
                                        <div class="row">
                                            {% for locale, lang in languages %}
                                            <div class="col-sm-6 col-md-4">
                                                <div class="form-group">
                                                    {{ form.input(
                                                        'Naziv - '~lang.translation | trans,
                                                        'title_'~locale,
                                                        IS_EDIT and payload.options[OPTIONS.OPTION_HOME_SCREEN_BAR] is defined and payload.options[OPTIONS.OPTION_HOME_SCREEN_BAR].configuration['tag_translations'] is defined ? payload.options[OPTIONS.OPTION_HOME_SCREEN_BAR].configuration['tag_translations'][locale]['title'] : '',
                                                        'translations['~locale~'][title]')
                                                    }}
                                                </div>
                                            </div><!-- Col -->
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    {{ include('Admin/Components/formButtons.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = {{ IS_EDIT ? app.request.attributes.get('id') : 0 }};
        const PRODUCTS = {{ IS_EDIT and payload.options[RULES.RULE_PRODUCTS] is defined ? payload.options[RULES.RULE_PRODUCTS].configuration | json_encode | raw : '[]' }};

        const PROMOTION_TYPE = '{{ payload.type ?? '' }}';

        const PROMOTION_TYPES = JSON.parse('{{ get_class_constants('App\\Entity\\Promotion', 'TYPE') | json_encode | raw }}');
    </script>
{% endblock %}
