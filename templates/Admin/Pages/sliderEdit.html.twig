{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_slider_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' slidera' %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}slider-edit{% endblock %}

{% block content %}


    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: title } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Slider - 2500x1230</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slika</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <label>Desktop slika</label>
                                {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'slider', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                            </div>
                            <div class="col-sm-6">
                                <label>Mobilna slika</label>
                                {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'slider_mobile', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                            </div>
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in app_params('languages') %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">{{ lang.name }}</h6>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    {{ form.textarea('Kratak opis', 'description_'~locale, IS_EDIT ? payload.translations[locale].description : '', locale~'[description]', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Link', 'link_'~locale, IS_EDIT ? payload.translations[locale].button_link : '', locale~'[link]') }}
                                </div>
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </form>
    {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ payload.media.images|json_encode()|raw }}');
        {% endif %}
    </script>
{% endblock %}
