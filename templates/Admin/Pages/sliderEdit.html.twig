{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje/Izmena slider{% endblock %}
{% block bodyClass %}slider-edit{% endblock %}
{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_slider_page' %}
{% block content %}


    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje - izmena proizvoda' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Slider</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slika</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'slider', 'class': 'dropzone-dark w-100'} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Srpski</h6>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    {{ form.textarea('Kratak opis', 'description_rs', IS_EDIT ? rs_description : '', 'rs_description', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Teks dugmeta', 'button_rs', IS_EDIT ? rs_button : '', 'rs_button') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Link', 'link_rs', IS_EDIT ? rs_link : '', 'rs_link') }}
                                </div>
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Engleski</h6>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    {{ form.textarea('Kratak opis', 'description_en', IS_EDIT ? en_description : '', 'en_description', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Teks dugmeta', 'button_en', IS_EDIT ? en_button : '', 'en_button') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Link', 'link_en', IS_EDIT ? en_link : '', 'en_link') }}
                                </div>
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Pozicija teksta</h6>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Levo', 'text_position', 1, 'position', 'form-check-label', 'form-check-input') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-4">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Sredina', 'text_position', IS_EDIT ? position : '', 'position', 'form-check-label', 'form-check-input') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-4">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Desno', 'text_position', IS_EDIT ? position : '', 'position', 'form-check-label', 'form-check-input') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('slider_submit', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script>
        const IS_EDIT = {{ app.request.attributes.has('slug') ? 1 : 0 }};
        const SLUG = '{{ app.request.attributes.get('slug') }}';

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ selectedImages|json_encode()|raw }}');
        {% endif %}
    </script>
{% endblock %}