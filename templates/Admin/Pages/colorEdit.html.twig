{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_color_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' boja' %}
{% set routePath = 'admin.colors' %}
{% set routeTitle = 'Boje' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">{{ title }}</h4>
        </div>
    </div>

<form id="edit_form" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                {{ form.input('Boja', 'color_field', IS_EDIT ? payload.hex : '', 'hex') }}
                            </div>
                        </div><!-- Col -->
                    </div><!-- Row -->
                </div>
            </div>
        </div>
    </div>
    {% for locale, lang in languages %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">{{ lang.translation | trans }}</h6>
                        <div class="row">
                            <div class="col-sm-6 col-md-4">
                                <div class="form-group">
                                    {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? payload.translations[locale]['title'] : null, 'translations['~locale~'][title]', '', 'text', null, 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
    {{ include('Admin/Components/formButtons.html.twig') }}
</form>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
    </script>
{% endblock %}
