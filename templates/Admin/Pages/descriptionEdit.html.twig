{% extends 'Admin/base.html.twig' %}

{% block bodyClass %}description-edit{% endblock %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_description_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' teksta' %}
{% set routePath = 'admin.descriptions' %}
{% set routeTitle = 'Tekstovi' %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">{{ title }}</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Tip teksta</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('', 'description_select_box', 'type', IS_EDIT ? payload.type : '' , typeOptions, '', 'w-100') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in app_params('languages') %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">{{ lang.name }}</h6>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <div class="form-group">
                                        {{ form.textarea('Tekst*', 'description_'~locale, payload.translations[locale].description ?? null , 'translations['~locale~'][description]', 10, '', 'form-control') }}
                                    </div>
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
{#        <div class="row">#}
{#            <div class="col-md-12 grid-margin">#}
{#                <div class="card">#}
{#                    <div class="card-body">#}
{#                        <h6 class="card-title">Engleski</h6>#}
{#                        <div class="row">#}
{#                            <div class="col-sm-12">#}
{#                                <div class="form-group">#}
{#                                    <div class="form-group">#}
{#                                        {{ form.textarea('Tekst *', 'description_en', en_description ?? null , 'en_description', 10, '', 'form-control') }}#}
{#                                    </div>#}
{#                                </div>#}
{#                            </div><!-- Col -->#}
{#                        </div><!-- Row -->#}
{#                    </div>#}
{#                </div>#}
{#            </div>#}
{#        </div>#}
    </form>
    <div class="row">
        <div class="col-md-6">
            {{ form.button('description_submit', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
        </div>
        <div class="col-md-6 text-right">
            <a href="{{ path(routePath) }}" class="btn btn-outline-warning cancel">Otkaži</a>
        </div>
    </div>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
    </script>
{% endblock %}
