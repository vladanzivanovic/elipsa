{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_home_banner_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' banera na početnoj stranici' %}
{% set routePath = 'admin.home_banners' %}
{% set routeTitle = 'Baneri' %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}banner-edit{% endblock %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Baner</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Veličine slika</h4>
                    <ul>
                        <li>Levo/Desno - 1000x1300 </li>
                        <li>Sredina - 1000x610 </li>
                        <li>Samostalan - 2500x1230 </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        {{ form.input('', '', 1, 'type', '', 'hidden') }}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Osnovni podaci</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Zemlja', 'country-select-box', 'available_countries[]', IS_EDIT ? payload.available_countries : '' , countries_options(), '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slika</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'banner', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in app_params('languages') %}
            <div id="language_{{ locale }}" class="row hide-country">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.translation | trans }}</h6>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        {{ form.textarea('Kratak opis', 'description_'~locale, IS_EDIT ? payload.translations[locale].description : '', 'translations['~locale~'][description]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Teks dugmeta', 'button_'~locale, IS_EDIT ? payload.translations[locale].button_text : '', 'translations['~locale~'][button]') }}
                                    </div>
                                </div><!-- Col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Link', 'link_'~locale, IS_EDIT ? payload.translations[locale].button_link : '', 'translations['~locale~'][link]') }}
                                    </div>
                                </div><!-- Row -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Pozicija banera</h6>
                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Levo', 'position_1', 1, 'position', 'form-check-label', 'form-check-input', IS_EDIT and payload.position == 1 ? 'checked=checked' : null) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-2">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Sredina gore', 'position_2', 2, 'position', 'form-check-label', 'form-check-input', IS_EDIT and payload.position == 2 ? 'checked=checked' : null) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-2">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Sredina dole', 'position_3', 3, 'position', 'form-check-label', 'form-check-input', IS_EDIT and payload.position == 3 ? 'checked=checked' : null) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-2">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Desno', 'position_4', 4, 'position', 'form-check-label', 'form-check-input', IS_EDIT and payload.position == 4 ? 'data-show-error-after=yes checked=checked' : 'data-show-error-after=yes') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-2">
                                <div class="form-check form-check-inline">
                                    {{ form.radio('Samostalan', 'position_5', 5, 'position', 'form-check-label', 'form-check-input', IS_EDIT and payload.position == 5 ? 'data-show-error-after=yes checked=checked' : 'data-show-error-after=yes') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="row">
        <div class="col-md-6">
            {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
        </div>
        <div class="col-md-6 text-right">
            <a href="{{ path(routePath) }}" class="btn btn-outline-warning cancel">Otkaži</a>
        </div>
    </div>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
        const IS_SPEED_LINKS = true;

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ payload.media.images|json_encode()|raw }}');
        {% endif %}
    </script>
{% endblock %}
