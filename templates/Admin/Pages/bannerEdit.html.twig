{% extends 'Admin/base.html.twig' %}

{% set bannerList = [
    {'title': 'Loyalty - 1920x533', 'value': constant('App\\Entity\\Banner::TYPE_LOYALTY')},
    {'title': 'Newsletter - 1500x1785 (mobilna - 600x800)', 'value': constant('App\\Entity\\Banner::TYPE_NEWS_LETTER')},
    {'title': 'PopUp - 1500x735 (mobilna - 600x800)', 'value': constant('App\\Entity\\Banner::TYPE_POP_UP')},
    {'title': 'Meni - 1000x1428', 'value': constant('App\\Entity\\Banner::TYPE_MENU')},
    {'title': 'Meni - Sezone - 1000x1428', 'value': constant('App\\Entity\\Banner::TYPE_SEASON')},
] %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_banner_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' banera' %}
{% set routePath = 'admin.banners' %}
{% set routeTitle = 'Baneri' %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}banner-edit{% endblock %}
{% block content %}


    {% include 'Admin/Components/breadcrumbs.html.twig' with {
        activePage: title,
        pages: [
            {routeName: routePath, name: routeTitle}
        ]
    } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Baner</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Baner</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Baner', 'banner-select-box', 'type', IS_EDIT ? payload.type : '' , bannerList, '', 'w-100') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slika</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <label>Desktop slika</label>
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'banner', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                            </div>
                            <div class="col-sm-6 mobile-image">
                                <label>Mobilna slika</label>
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'banner_mobile', 'class': 'dropzone-dark w-100', 'maxFiles': 1} %}
                            </div>
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in app_params('languages') %}
        <div class="row links">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">{{ lang.name }}</h6>
                        <div class="row">
                            <div class="col-sm-6 btn-text">
                                <div class="form-group">
                                    {{ form.input('Teks dugmeta', 'button_'~locale, IS_EDIT ? payload.translations[locale].button_text : '', locale~'[button]') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Link', 'link_'~locale, IS_EDIT ? payload.translations[locale].button_link : '', locale~'[link]') }}
                                </div>
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </form>
    <div class="row">
        <div class="col-md-6">
            {{ form.button('banner_submit', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
        </div>
        <div class="col-md-6 text-right">
            <a href="{{ path(routePath) }}" class="btn btn-outline-warning cancel">Otkaži</a>
        </div>
    </div>
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
        const IS_SPEED_LINKS = false;
        const BANNER_TYPES = JSON.parse('{{ get_class_constants('App\\Entity\\Banner') | json_encode() | raw }}');

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ payload.media.images|json_encode()|raw }}');
        {% endif %}
    </script>
{% endblock %}
