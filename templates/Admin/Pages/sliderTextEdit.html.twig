{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje/Izmena teksta{% endblock %}
{% block bodyClass %}slider-edit{% endblock %}
{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_slider_text_page' %}
{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje - izmena slider teksta' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <form id="edit_form" enctype="multipart/form-data">
        {% for locale, lang in app_params('languages') %}
            <div class="row">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.name }}</h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? payload[locale]['title'] : '', locale~'[title]') }}
                                    </div>
                                </div><!-- Col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Opis', 'description_'~locale, IS_EDIT ? payload[locale]['description'] : '', locale~'[description]') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Link', 'link_'~locale, IS_EDIT ? payload[locale]['link'] : '', locale~'[link]') }}
                                    </div>
                                </div><!-- Row -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Pozicija teksta</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Pozicija', 'position-select-box', 'position', IS_EDIT ? payload.position : '' , positionOptions, '', 'w-100') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ IS_EDIT ? 1 : 0 }};
        const ID = '{{ app.request.attributes.get('id') }}';
    </script>
{% endblock %}
