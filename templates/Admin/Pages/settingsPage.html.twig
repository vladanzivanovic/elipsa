{% extends 'Admin/base.html.twig' %}

{% block title %}Podešavanje sajta{% endblock %}
{% block bodyClass %}settings-page{% endblock %}

{% block content %}
    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Podešavanje sajta' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Podešavanje sajta</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data" class="forms-sample">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Podaci o kompaniji</h6>
                        <div class="row">
                            {% for setting in settings.company %}
                                {% if setting.inputType != 'textarea' %}
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ form.input(setting.name, 'name_' ~ setting.id, setting.value, setting.id, '', setting.inputType) }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <div class="row">
                            {% for setting in settings.company %}
                                {% if setting.inputType == 'textarea' %}
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ form.textarea(setting.name ~ ' - ' ~ languages[setting.locale].name, 'name_' ~ setting.id, setting.value, setting.id, 10, '', 'form-control') }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Podešavanje sajta</h6>
                        <div class="row">
                            {% for setting in settings.site %}
                                {% if setting.inputType != 'textarea' %}
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ form.input(setting.name, 'name_' ~ setting.id, setting.value, setting.id, '', setting.inputType) }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <div class="row">
                            {% for setting in settings.site %}
                                {% if setting.inputType == 'textarea' %}
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ form.textarea(setting.name ~ ' - ' ~ languages[setting.locale].name, 'name_' ~ setting.id, setting.value, setting.id, 10, '', 'form-control') }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% for countryCode, country in countries %}
            <div class="row">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ country.translation | trans }} - Besplatna dostava</h6>
                            <div class="row">
                                {% for setting in settings.shipping_prices[countryCode] %}
                                    {% if setting.inputType != 'textarea' %}
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                {{ form.input(setting.name, 'name_' ~ setting.id, setting.value, setting.id, '', setting.inputType) }}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
{#                            <div class="row">#}
{#                                {% for setting in settings.shipping_price %}#}
{#                                    {% if setting.inputType == 'textarea' %}#}
{#                                        <div class="col-sm-6">#}
{#                                            <div class="form-group">#}
{#                                                {{ form.textarea(setting.name ~ ' - ' ~ languages[setting.locale].name, 'name_' ~ setting.id, setting.value, setting.id, 10, '', 'form-control') }}#}
{#                                            </div>#}
{#                                        </div>#}
{#                                    {% endif %}#}
{#                                {% endfor %}#}
{#                            </div>#}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Footer tekst</h6>
                        <div class="row">
                            {% for setting in settings.footer %}
                                {% if setting.inputType == 'textarea' %}
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {% set langName = languages[setting.locale].translation | trans %}
                                            {{ form.textarea(setting.name ~ ' - ' ~ langName, 'name_' ~ setting.id, setting.value, setting.id, 10, '', 'form-control') }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('settings_submit', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
