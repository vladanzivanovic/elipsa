{% extends('Admin/base.html.twig') %}

{% block content %}
    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Proizvodi</h4>
        </div>
        <div class="d-flex align-items-center flex-wrap text-nowrap">
            <a href="{{ path('admin.add_product_page') }}" class="btn btn-primary btn-icon-text mb-2 mb-md-0">
                <i class="btn-icon-prepend" data-feather="download-cloud"></i>
                Dodaj proizvod
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filter</h4>
                    <form id="product_filter_form">
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {{ form.input('Naziv', 'title', '', 'title') }}
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {{ form.input('Šifra', 'code', '', 'code') }}
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {% set defaultSelection = constant('App\\Entity\\Product::STATUS_ACTIVE') ~','~
                                        constant('App\\Entity\\Product::STATUS_PENDING') %}
                                    {%
                                        set productStatusOptions = [
                                        {
                                            'title': 'Svi',
                                            'value':
                                            constant('App\\Entity\\Product::STATUS_ACTIVE') ~','~
                                            constant('App\\Entity\\Product::STATUS_PENDING') ~','~
                                            constant('App\\Entity\\Product::STATUS_ARCHIVED')
                                        },
                                        {
                                            'title': 'Aktivni i na čekanju',
                                            'value': defaultSelection
                                        },
                                        {
                                            'title': 'Aktivni',
                                            'value': constant('App\\Entity\\Product::STATUS_ACTIVE')
                                        },
                                        {
                                            'title': 'Na čekanju',
                                            'value': constant('App\\Entity\\Product::STATUS_PENDING')
                                        },
                                        {
                                            'title': 'Arhivirani',
                                            'value': constant('App\\Entity\\Product::STATUS_ARCHIVED')
                                        }
                                    ]
                                    %}
                                    {{ form.selectNew(
                                        productStatusOptions,
                                        defaultSelection,
                                        false,
                                        {'class': 'w-100', 'labelTitle': 'Prikaz proizvoda po statusu', 'id': 'product_status'},
                                        null
                                    ) }}
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {{ form.selectNew(
                                        options.tags,
                                        '',
                                        true,
                                        {'class': 'w-100', 'labelTitle': 'Tagovi', 'id': 'tags', 'name': 'tags[]'}
                                    ) }}
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {{ form.selectNew(
                                        options.categories,
                                        '',
                                        true,
                                        {'class': 'w-100', 'labelTitle': 'Kategorije', 'id': 'categories', 'name': 'categories[]'}
                                    ) }}
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {%
                                        set homePageOptions = [
                                        {'title': 'Sve pozicije', 'value': ''},
                                        {'title': 'Gore', 'value': constant('App\\Entity\\ProductOptions::HOME_PAGE_UP')},
                                        {'title': 'Dole', 'value': constant('App\\Entity\\ProductOptions::HOME_PAGE_DOWN')}
                                    ]
                                    %}
                                    {{ form.selectNew(
                                        homePageOptions,
                                        '',
                                        false,
                                        {'class': 'w-100', 'labelTitle': 'Prikaz na početnoj stranici', 'id': 'home_page_show'},
                                        null
                                    ) }}
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    {%
                                        set countryOptions = [
                                        {'title': 'Sve', 'value': ''},
                                        {'title': 'Srbija', 'value': 'rs'},
                                        {'title': 'BiH', 'value': 'ba'}
                                    ]
                                    %}
                                    {{ form.selectNew(
                                        countryOptions,
                                        '',
                                        false,
                                        {'class': 'w-100', 'labelTitle': 'Zemlja', 'id': 'country'},
                                        null
                                    ) }}
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <p>&nbsp;</p>
                                    <div class="form-check form-check-flat form-check-primary">
                                        {{ form.checkbox('Rasprodato', 'sold', 1, 'sold', 'form-check-label', 'form-check-input' ) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Filtriraj', 'button') }}
                            </div>
                            <div class="col-sm-6 text-right">
                                {{ form.button('reset_btn', 'btn btn-outline-warning reset', 'Reset', 'button') }}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table" id="data-table"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{ include('Admin/Components/confirmationModal.html.twig') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const CAN_VIEW = true;
        const CAN_EDIT = true;
        const CAN_REMOVE = true;

        const PRODUCT_CONSTANTS = JSON.parse('{{ get_class_constants('App\\Entity\\Product') | json_encode() | raw }}');
        const PRODUCT_OPTIONS_CONSTANTS = JSON.parse('{{ get_class_constants('App\\Entity\\ProductOptions') | json_encode() | raw }}');

    </script>
{% endblock %}
