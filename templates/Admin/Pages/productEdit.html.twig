{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje/Izmena proizvoda{% endblock %}
{% block bodyClass %}product-edit{% endblock %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_product_page' %}

{% block content %}

    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje - izmena proizvoda' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Proizvodi - 1060x1580</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        {% for locale, lang in app_params('languages') %}
            <div class="row">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.name }}</h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT ? payload[locale]['title'] : '', locale~'[title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.textarea('Kratak opis', 'short_description_'~locale, IS_EDIT ? payload[locale]['short_description'] : '', locale~'[short_description]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.textarea('Opis', 'description_rs'~locale, IS_EDIT ? payload[locale]['description'] : '', locale~'[description]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.textarea('Materijali i održavanje', 'cleaning_'~locale, IS_EDIT ? payload[locale]['cleaning'] : '', locale~'[cleaning]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Dodatne informacije</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Šifra', 'code', IS_EDIT ? payload['code'] : '', 'code') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Kategorija', 'categories', 'categories[]', IS_EDIT ? payload['selectedCategories'] : '', options.categories, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Tagovi', 'tags', 'tags[]', IS_EDIT ? payload['selectedTags'] : '', options.tags, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Veličine', 'sizes', 'sizes[]', IS_EDIT ? payload['selectedSizes'] : '', options.sizes, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Cena', 'price', IS_EDIT ? payload['price'] : '', 'price') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Popust', 'discount', IS_EDIT ? payload.discount.price : '', 'discount') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <p>Prikaz na pocetnoj stranici</p>
                                <div class="form-check form-check-flat form-check-primary">
                                    {% set upValue = constant('App\\Entity\\Product::HOME_PAGE_UP') %}
                                    {{ form.checkbox('Gore', 'home_page_checkbox_up', upValue, 'show_home_page', 'form-check-label', 'form-check-input', IS_EDIT and payload['show_home_page'] == upValue ? 'checked="checked"' : null ) }}
                                </div>
                                <div class="form-check form-check-flat form-check-primary">
                                    {% set downValue = constant('App\\Entity\\Product::HOME_PAGE_DOWN') %}

                                    {{ form.checkbox('Dole', 'home_page_checkbox_down', downValue, 'show_home_page', 'form-check-label', 'form-check-input', IS_EDIT and payload['show_home_page'] == downValue ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-3">
                                <p>&nbsp;</p>
                                <div class="form-check form-check-flat form-check-primary">
                                    {{ form.checkbox('Rasprodato', 'sold', 1, 'sold', 'form-check-label', 'form-check-input', IS_EDIT and payload['is_sold'] == true ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 id="card_title" class="card-title">Materijali i održavanje</h6>
                        <div class="row">
                            {% for icon in cleaning %}
                                {% set additionalAttributes = 'data-error-after=\'#card_title\' ' %}
                                {% if IS_EDIT and icon in payload['cleaning_box'] %}
                                    {% set additionalAttributes = additionalAttributes ~ 'checked="checked"' %}
                                {% endif %}

                                <div class="col-4 col-sm-1">
                                    <div class="form-check form-check-flat form-check-primary">
                                        <span class="cleaning-icons {{ icon }}" style="font-size: 40px;width: 100%;display: block;margin-left: 1.3rem;" title="{{ icon | trans }}"></span>
                                        {{ form.checkbox('', 'cleaning_'~icon, icon, 'cleaning[]', 'form-check-label position-relative', 'form-check-input', additionalAttributes) }}
                                    </div>
                                </div><!-- Col -->
                            {% endfor %}
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slike</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'mainImages', 'class': 'dropzone-dark w-100', 'maxFiles': 100} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Video</h6>
                        <div class="row">
                            <div class="col-md-12">
                                {% include 'Admin/Components/youtube.html.twig' %}
                            </div>
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('submit_btn', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ app.request.attributes.has('slug') ? 1 : 0 }};
        const SLUG = '{{ app.request.attributes.get('slug') }}';
        const COLORS = JSON.parse('{{ options.colors|json_encode|raw }}');

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ payload['selectedImages']|json_encode()|raw }}');
            const YOUTUBES = JSON.parse('{{ payload['youtubes'] | json_encode | e('js') }}');
        {% endif %}

    </script>
{% endblock %}
