{% extends 'Admin/base.html.twig' %}

{% block title %}Dodavanje/Izmena proizvoda{% endblock %}
{% block bodyClass %}product-edit{% endblock %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_product_page' %}

{% block content %}

    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: 'Dodavanje - izmena proizvoda' } %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Proizvodi - 1060x1580</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Srpski</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Naziv', 'title_rs', IS_EDIT ? rs_title : '', 'rs_title') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.textarea('Kratak opis', 'short_description_rs', IS_EDIT ? rs_short_description : '', 'rs_short_description', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.textarea('Opis', 'description_rs', IS_EDIT ? rs_description : '', 'rs_description', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.textarea('Materijali i održavanje', 'cleaning_rs', IS_EDIT ? rs_cleaning : '', 'rs_cleaning', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Engleski</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Naziv', 'title_en', IS_EDIT ? en_title : '', 'en_title') }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.textarea('Kratak opis', 'short_description_en', IS_EDIT ? en_short_description : '', 'en_short_description', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.textarea('Opis', 'description_en', IS_EDIT ? en_description : '', 'en_description', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Row -->
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.textarea('Materijali i održavanje', 'cleaning_en', IS_EDIT ? en_cleaning : '', 'en_cleaning', 10, '', 'form-control') }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Dodatne informacije</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Šifra', 'code', IS_EDIT ? code : '', 'code') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Kategorija', 'categories', 'categories[]', IS_EDIT ? selectedCategories : '', categories, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Tagovi', 'tags', 'tags[]', IS_EDIT ? selectedTags : '', tags, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Veličine', 'sizes', 'sizes[]', IS_EDIT ? selectedSizes : '', sizes, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Cena', 'price', IS_EDIT ? price : '', 'price') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Popust', 'discount', IS_EDIT ? discount : '', 'discount') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-check form-check-flat form-check-primary">
                                    {% set upValue = constant('App\\Entity\\Product::HOME_PAGE_UP') %}
                                    {{ form.radio('Početna strana gore', 'home_page_checkbox_up', upValue, 'show_home_page', 'form-check-label', 'form-check-input', IS_EDIT and show_home_page == upValue ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-check form-check-flat form-check-primary">
                                    {% set downValue = constant('App\\Entity\\Product::HOME_PAGE_DOWN') %}

                                    {{ form.radio('Početna strana dole', 'home_page_checkbox_down', downValue, 'show_home_page', 'form-check-label', 'form-check-input', IS_EDIT and show_home_page == downValue ? 'checked="checked"' : null ) }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 id="card_title" class="card-title">Materijali i održavanje</h6>
                        <div class="row">
                            {% for icon in cleaning %}
                                {% set additionalAttributes = 'data-error-after=\'#card_title\' ' %}
                                {% if IS_EDIT and icon in cleaning_box %}
                                    {% set additionalAttributes = additionalAttributes ~ 'checked="checked"' %}
                                {% endif %}

                                <div class="col-4 col-sm-1">
                                    <div class="form-check form-check-flat form-check-primary">
                                        <span class="cleaning-icons {{ icon }}" style="font-size: 40px;width: 100%;display: block;margin-left: 1.3rem;" title="{{ icon | trans }}"></span>
                                        {{ form.checkbox('', 'cleaning_'~icon, icon, 'cleaning[]', 'form-check-label position-relative', 'form-check-input', additionalAttributes) }}
                                    </div>
                                </div><!-- Col -->
                            {% endfor %}
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slike</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'mainImages', 'class': 'dropzone-dark w-100', 'maxFiles': 100} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ form.button('product_submit', 'btn btn-outline-primary submit', 'Sačuvaj', 'button') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ app.request.attributes.has('slug') ? 1 : 0 }};
        const SLUG = '{{ app.request.attributes.get('slug') }}';
        const COLORS = JSON.parse('{{ colors|json_encode|raw }}');

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ selectedImages|json_encode()|raw }}');
        {% endif %}

    </script>
{% endblock %}