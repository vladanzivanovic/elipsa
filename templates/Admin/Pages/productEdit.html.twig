{% extends 'Admin/base.html.twig' %}

{% set IS_EDIT = app.request.attributes.get('_route') == 'admin.edit_product_page' %}
{% set titlePrefix = IS_EDIT == true ? 'Izmena' : 'Dodavanje' %}
{% set title = titlePrefix ~ ' proizvoda' %}
{% set routePath = 'admin.dashboard' %}
{% set routeTitle = 'Početna' %}

{% block title %}{{ title }}{% endblock %}
{% block bodyClass %}product-edit{% endblock %}

{% set productSizes = {} %}

{% for countryCode, country in countries %}
    {% if true == IS_EDIT and payload.options[countryCode] is defined %}
        {% set productSizes = productSizes|merge({(countryCode): payload.options[countryCode].sizes}) %}
    {% else %}
        {% set productSizes = productSizes|merge({(countryCode): [
            {'slug': '38', 'quantity': 20},
            {'slug': '40', 'quantity': 20},
            {'slug': '42', 'quantity': 20},
            {'slug': '44', 'quantity': 20},
            {'slug': '46', 'quantity': 20},
            {'slug': '48', 'quantity': 20},
        ]}) %}
    {% endif %}
{% endfor %}

{% block content %}

    {% include 'Admin/Components/breadcrumbs.html.twig' with {activePage: title} %}

    {% import 'Admin/Macros/Inputs/formWithLabels.html.twig' as form %}
    {% import 'Admin/Macros/Inputs/input.html.twig' as inputs %}

    <div class="d-flex justify-content-between align-items-center flex-wrap grid-margin">
        <div>
            <h4 class="mb-3 mb-md-0">Proizvodi - 2500x3731</h4>
        </div>
    </div>

    <form id="edit_form" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Odabir države</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Zemlja', 'country-select-box', 'available_countries[]', IS_EDIT ? payload.available_countries : '' , countries_options(), '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% for locale, lang in languages %}
            <div class="row country_{{ locale }} hide-country">
                <div class="col-md-12 grid-margin">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ lang.translation | trans }} - Opis</h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Naziv', 'title_'~locale, IS_EDIT and payload.translations[locale] is defined ? payload.translations[locale]['title'] : '', 'translations['~locale~'][title]') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.textarea('Kratak opis', 'short_description_'~locale, IS_EDIT and payload.translations[locale] is defined ? payload.translations[locale]['short_description'] : '', 'translations['~locale~'][short_description]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.textarea('Opis', 'description_rs'~locale, IS_EDIT and payload.translations[locale] is defined ? payload.translations[locale]['description'] : '', 'translations['~locale~'][description]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.textarea('Materijali i održavanje', 'cleaning_'~locale, IS_EDIT and payload.translations[locale] is defined ? payload.translations[locale]['cleaning'] : '', 'translations['~locale~'][cleaning]', 10, '', 'form-control') }}
                                    </div>
                                </div><!-- Col -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Osnovne informacije</h6>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.input('Šifra', 'code', IS_EDIT ? payload['code'] : '', 'code') }}
                                </div>
                            </div><!-- Col -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Kategorija', 'categories', 'categories[]', IS_EDIT ? payload['selectedCategories'] : '', options.categories, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ form.select('Tagovi', 'tags', 'tags[]', IS_EDIT ? payload['selectedTags'] : '', options.tags, '', 'w-100', true) }}
                                </div>
                            </div><!-- Col -->
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            {% for countryCode, country in countries %}
                {% set option = payload.options[countryCode] is defined ? payload.options[countryCode] : [] %}
                <div class="col-md-6 grid-margin country_{{ countryCode }} hide-country">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">Cene i prikaz - {{ country.translation | trans }}</h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Cena', 'price_'~countryCode, IS_EDIT and 0 < option|length ? option.price.unformatted_amount : '', 'options['~countryCode~'][price]') }}
                                    </div>
                                </div><!-- Col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {{ form.input('Popust', 'discount_'~countryCode, IS_EDIT and 0 < option|length and null != option.discount ? option.discount.price.unformatted_amount : '', 'options['~countryCode~'][discount]') }}
                                    </div>
                                </div><!-- Col -->
                            </div>
                            <div class="row">
                                <div class="col-sm-3">
                                    <p>Prikaz na pocetnoj stranici</p>
                                    <div class="form-check form-check-flat form-check-primary">
                                        {% set upValue = constant('App\\Entity\\ProductOptions::HOME_PAGE_UP') %}
                                        {{ form.checkbox('Gore', 'home_page_checkbox_up_'~countryCode, upValue, 'options['~countryCode~'][show_home_page]', 'form-check-label', 'form-check-input', IS_EDIT and 0 < option|length and option.show_home_page == upValue ? 'checked="checked"' : null ) }}
                                    </div>
                                    <div class="form-check form-check-flat form-check-primary">
                                        {% set downValue = constant('App\\Entity\\ProductOptions::HOME_PAGE_DOWN') %}

                                        {{ form.checkbox('Dole', 'home_page_checkbox_down_'~countryCode, downValue, 'options['~countryCode~'][show_home_page]', 'form-check-label', 'form-check-input', IS_EDIT and 0 < option|length and option.show_home_page == downValue ? 'checked="checked"' : null ) }}
                                    </div>
                                </div><!-- Col -->
                                <div class="col-sm-3">
                                    <p>&nbsp;</p>
                                    <div class="form-check form-check-flat form-check-primary">
                                        {{ form.checkbox('Rasprodato', 'sold_'~countryCode, 1, 'options['~countryCode~'][sold]', 'form-check-label', 'form-check-input', IS_EDIT and 0 < option|length and option.is_sold == true  ? 'checked="checked"' : null ) }}
                                    </div>
                                </div><!-- Col -->
                            </div><!-- Row -->
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="row">
            {% for countryCode, country in countries %}
                <div class="col-md-6 grid-margin country_{{ countryCode }} hide-country">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title row">
                                <div class="col-md-6">
                                    Veličine - {{ country.translation | trans }}
                                </div>
                                <div class="col-md-6 text-right">
                                    <button class="btn btn-primary size-add-btn-{{ countryCode }}" type="button">Dodaj veličinu</button>
                                </div>
                            </h6>

                            <div class="table-responsive">
                                <table class="table table-hover size-table-{{ countryCode }}">
                                    <thead>
                                    <tr>
                                        <th>Veličina</th>
                                        <th>Količina</th>
                                        <th></th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 id="card_title" class="card-title">Materijali i održavanje</h6>
                        <div class="row">
                            {% for icon in cleaning %}
                                {% set additionalAttributes = 'data-error-after=\'#card_title\' ' %}
                                {% if IS_EDIT and icon in payload['cleaning_box'] %}
                                    {% set additionalAttributes = additionalAttributes ~ 'checked="checked"' %}
                                {% endif %}

                                <div class="col-4 col-sm-1">
                                    <div class="form-check form-check-flat form-check-primary">
                                        <span class="cleaning-icons {{ icon }}" style="font-size: 40px;width: 100%;display: block;margin-left: 1.3rem;" title="{{ icon | trans }}"></span>
                                        {{ form.checkbox('', 'cleaning_'~icon, icon, 'cleaning[]', 'form-check-label position-relative', 'form-check-input', additionalAttributes) }}
                                    </div>
                                </div><!-- Col -->
                            {% endfor %}
                        </div><!-- Row -->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Slike</h6>
                        <div class="row">
                            {% include 'Moduls/dropzone.html.twig' with {'dropzoneName': 'mainImages', 'class': 'dropzone-dark w-100', 'maxFiles': 100} %}
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Video</h6>
                        <div class="row">
                            <div class="col-md-12">
                                {% include 'Admin/Components/youtube.html.twig' %}
                            </div>
                        </div><!--Row-->
                    </div>
                </div>
            </div>
        </div>
    </form>
    {{ include('Admin/Components/formButtons.html.twig') }}
{% endblock %}
{% block pageJavascript %}
    <script nonce="{{ csp_nonce('script') }}">
        const IS_EDIT = {{ app.request.attributes.has('slug') ? 1 : 0 }};
        const SLUG = '{{ app.request.attributes.get('slug') }}';
        const COLORS = JSON.parse('{{ options.colors|json_encode|raw }}');
        const SIZES = JSON.parse('{{ options.sizes | json_encode | raw }}');
        const PRODUCT_SIZES = JSON.parse('{{ productSizes | json_encode | raw }}');

        {% if IS_EDIT %}
            const IMAGES = JSON.parse('{{ payload['selectedImages']|json_encode()|raw }}');
            const YOUTUBES = JSON.parse('{{ payload['youtubes'] | json_encode | e('js') }}');

        {% endif %}

    </script>
{% endblock %}
