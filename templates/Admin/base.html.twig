{% set routeName = app.request.attributes.get('_route') %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{% block title %}{% endblock %}</title>

    <link rel="shortcut icon" href="../../../assets/images/favicon.png" />

    {% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('build/css/admin/app.css') }}"/>
    {% endblock %}
</head>
<body class="{% block bodyClass %}{% endblock %}">
<div class="main-wrapper">

    <!-- partial:../../partials/_sidebar.html -->
    {% include 'Admin/Components/sideBar.html.twig' %}
    <!-- partial -->

    <div class="page-wrapper">

        <!-- partial:../../partials/_navbar.html -->
        {% include 'Admin/Components/navBar.html.twig' %}
        <!-- partial -->

        <div class="page-content">
            {% block content %}{% endblock %}
        </div>

        <!-- partial:../../partials/_footer.html -->
        {% include 'Admin/Components/footer.html.twig' %}
        <!-- partial -->

    </div>
</div>
{% block javascripts %}
    <script nonce="{{ csp_nonce('script') }}">
        const LOCALE = '{{ 'DEFAULT_LOCALE' | getenv }}';;
        const ROUTE_NAME = '{{ routeName }}';
        const LANGUAGES = JSON.parse('{{ languages | json_encode | raw }}');
        const YOUTUBE_API_KEY = '{{ 'YOUTUBE_API_KEY' | getenv }}';
        const COUNTRIES = JSON.parse('{{ countries | json_encode | raw }}');
        const IMAGE_DEVICES = JSON.parse('{{ get_class_constants('App\\Entity\\Image', 'DEVICE') | json_encode() | raw }}');
        const ENTITY_STATUSES = JSON.parse('{{ get_class_constants('App\\Entity\\Resources\\StatusInterface', 'STATUS') | json_encode() | raw }}');

        window.Messages = {{ app.session.flashBag.get('message')|json_encode|raw }};
    </script>
    <script src="{{ preload(asset('build/runtime.js')) }}"></script>
    <script src="{{ asset('bundles/bazingajstranslation/js/translator.min.js') }}"></script>
    <script src="{{ url('bazinga_jstranslation_js', { 'domain': 'messages', 'locales': 'rs,en' }) }}"></script>
    <script src="{{ url('bazinga_jstranslation_js', { 'domain': 'validators', 'locales': 'rs,en' }) }}"></script>
    <script type="text/javascript" src="{{ asset('build/js/admin/app.js') }}"></script>
    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
{% endblock %}
{% block pageJavascript %}{% endblock %}
</body>
</html>
