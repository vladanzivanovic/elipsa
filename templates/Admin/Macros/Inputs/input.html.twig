{% macro input(id, value, name, placeholder = "", type = "text", class = "", additionalAttributes = null) %}
    <input type="{{ type }}" id="{{ id }}" name="{{ name }}" class="{{ class }}" placeholder="{{ placeholder }}" value="{{ value }}" {{ additionalAttributes }}>
{% endmacro %}

{% macro textarea(id, value, name, rows = "10", placeholder = "", class = "") %}
    <textarea name="{{ name }}" id="{{ id }}" class="{{ class }}" rows="{{ rows }}" placeholder="{{ placeholder }}">{{ value }}</textarea>
{% endmacro %}

{% macro selectbox(id, name, selected, options, placeholder = "", class = "", multiple = false) %}
    <select id="{{ id }}" class="{{ class }}" {{ true == multiple ? 'multiple="multiple"' }}>
        <option>Izaberite...</option>
        {% for option in options %}
            <option value="{{ option.value }}" {{ option.value == selected ? 'selected="selected"' : '' }}>{{ option.title }}</option>
        {% endfor %}
    </select>
{% endmacro %}
